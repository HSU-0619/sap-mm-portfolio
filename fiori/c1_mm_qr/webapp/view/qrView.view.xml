<mvc:View
    controllerName="c1.mm.c1mmqr.controller.qrView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page id="mainPage" showHeader="false" enableScrolling="false" class="sapUiNoContentPadding qrMain">
        <content>
            <VBox id="qrRoot" class="qrRoot">

                <!-- TOP TOOLBAR -->
                <Toolbar id="qrTopBar" class="qrTopBar">
                    <Title text="QR 자재 추적 관리" level="H4" class="qrAppTitle"/>
                    <ToolbarSpacer/>
                    <Button
                        id="btnNavHist"
                        icon="sap-icon://history"
                        text="발행이력"
                        type="Default"
                        press="onNavToHist"/>
                </Toolbar>

                <!-- TABS -->
                <IconTabBar
                    id="mainTabs"
                    expandable="false"
                    headerMode="Inline"
                    backgroundDesign="Transparent"
                    headerBackgroundDesign="Solid"
                    select="onMainTabSelect"
                    class="qrMainTabs">
                    <items>

                    <IconTabFilter id="tabIssue" text="QR 발행 관리" key="issue" icon="sap-icon://bar-code">

                <!-- MAIN WORK AREA -->
                <HBox id="workArea" renderType="Bare" class="qrWorkArea">

                    <!-- LEFT FILTER -->
                    <VBox id="filterPanel" class="qrSidePanel sapUiSizeCompact">

                        <Toolbar class="qrPanelHeader">
                            <Title text="조회 조건" level="H5"/>
                            <ToolbarSpacer/>
                        </Toolbar>

                        <VBox class="qrSideBody">

                            <Label text="자재번호"/>
                            <Input id="sfMatnr" placeholder="자재번호" width="100%" showValueHelp="true" valueHelpRequest="onVHMatnr" submit="onSearch"/>

                            <Label text="구매오더번호" class="sapUiTinyMarginTop"/>
                            <Input id="sfEbeln" placeholder="구매오더번호" width="100%" showValueHelp="true" valueHelpRequest="onVHEbeln" submit="onSearch"/>

                            <Label text="입고문서" class="sapUiTinyMarginTop"/>
                            <Input id="sfMblnr" placeholder="자재문서번호" width="100%" showValueHelp="true" valueHelpRequest="onVHMblnr" submit="onSearch"/>

                            <Label text="배치번호" class="sapUiTinyMarginTop"/>
                            <Input id="sfCharg" placeholder="배치번호" width="100%" showValueHelp="true" valueHelpRequest="onVHCharg" submit="onSearch"/>

                            <Label text="QR 발행상태" class="sapUiTinyMarginTop"/>
                            <Select id="selQrStatus" width="100%" selectedKey="ALL">
                                <core:Item key="ALL" text="전체"/>
                                <core:Item key="NONE" text="미발행"/>
                                <core:Item key="X" text="발행완료"/>
                            </Select>

                            <Label text="입고일" class="sapUiTinyMarginTop"/>
                            <DatePicker
                                id="dpFrom"
                                placeholder="시작일"
                                width="100%"
                                valueFormat="yyyyMMdd"
                                displayFormat="yyyy-MM-dd"/>
                            <DatePicker
                                id="dpTo"
                                placeholder="종료일"
                                width="100%"
                                valueFormat="yyyyMMdd"
                                displayFormat="yyyy-MM-dd"
                                class="sapUiTinyMarginTop"/>

                            <Button text="조회" type="Emphasized" icon="sap-icon://search" press="onSearch" width="100%" class="sapUiSmallMarginTop"/>
                            <Button text="초기화" icon="sap-icon://undo" type="Emphasized" press="onReset" width="100%" class="sapUiTinyMarginTop"/>

                        </VBox>
                    </VBox>

                    <!-- CENTER LIST -->
                    <VBox id="listPanel" class="qrListPanel">

                        <Toolbar class="qrPanelHeader">
                            <VBox>
                                <Title id="listHeader" text="QR 발행 목록" level="H5"/>
                                <Text id="listSubHeader" text="입고 완료 자재 기준 조회" class="qrPanelSubText"/>
                            </VBox>
                            <ToolbarSpacer/>
                            <Button
                                id="btnBulkIssue"
                                text="일괄 발행"
                                type="Emphasized"
                                icon="sap-icon://print"
                                press="onBulkIssue"
                                enabled="false"/>
                            <Button icon="sap-icon://sort" type="Transparent" tooltip="정렬" press="onSortPress"/>
                        </Toolbar>

                        <VBox class="qrListBody">
                            <Table
                                id="qrTargetTable"
                                mode="MultiSelect"
                                includeItemInSelection="false"
                                selectionChange="onSelectionChange"
                                noDataText="조회된 자재가 없습니다."
                                growing="true"
                                growingThreshold="30"
                                class="qrTargetTable">

                                <columns>
                                    <Column width="14%"><Text text="자재번호"/></Column>
                                    <Column width="26%"><Text text="자재명"/></Column>
                                    <Column width="17%" hAlign="Center"><Text text="배치번호"/></Column>
                                    <Column width="16%" hAlign="Right"><Text text="총수량"/></Column>
                                    <Column width="14%" hAlign="Center"><Text text="최신 입고일"/></Column>
                                    <Column width="13%" hAlign="Center"><Text text="QR상태"/></Column>
                                </columns>

                            </Table>
                        </VBox>

                    </VBox>

                    <!-- RIGHT DETAIL -->
                    <VBox id="rightArea" class="qrRightArea">

                        <VBox id="emptyDetail" class="qrEmptyDetail" alignItems="Center" justifyContent="Center">
                            <core:Icon src="sap-icon://bar-code" size="3rem" color="#B0B8C1"/>
                            <Title text="자재를 선택하세요" level="H4" class="sapUiSmallMarginTop"/>
                            <Text text="목록에서 자재를 선택하면 QR 미리보기와 상세 정보가 표시됩니다." textAlign="Center" wrapping="true"/>
                        </VBox>

                        <VBox id="detailPanel" visible="false" class="qrDetailPanel">

                          <!-- 스크롤 영역 (헤더~현재고) -->
                          <VBox class="qrDetailScroll">

                            <!-- DETAIL HEADER -->
                            <VBox class="qrDetailHeader">
                                <HBox justifyContent="SpaceBetween" alignItems="Start">
                                    <VBox>
                                        <HBox alignItems="Center">
                                            <Title id="dMatnr" text="" level="H2" class="qrDetailNo"/>
                                            <core:HTML id="dStatusBadge" content="" preferDOM="false" class="sapUiSmallMarginBegin"/>
                                        </HBox>
                                        <Text id="dMaktx" text="" class="qrDetailSub"/>
                                    </VBox>
                                    <VBox alignItems="End">
                                        <Text id="dLgort" text="" class="qrDetailMeta"/>
                                        <Text id="dBudat" text="" class="qrDetailMeta"/>
                                        <Text id="dMenge" text="" class="qrDetailAmt"/>
                                    </VBox>
                                </HBox>
                            </VBox>

                            <!-- QR PREVIEW -->
                            <VBox id="qrPreviewBox" class="qrPreviewBox" alignItems="Center">
                                <core:HTML id="qrCanvas" content="&lt;div id='qrCodeDiv' class='qrCodeArea'&gt;&lt;/div&gt;" preferDOM="true"/>
                                <Text id="qrNoText" text="" class="qrNoLabel sapUiSmallMarginTop"/>
                            </VBox>

                            <!-- DETAIL INFO -->
                            <VBox class="qrInfoSection">
                                <HBox class="qrInfoRow" alignItems="Center">
                                    <Label text="구매오더번호" class="qrInfoLabel"/>
                                    <Text id="dEbeln" text="" class="qrInfoVal"/>
                                </HBox>
                                <HBox class="qrInfoRow" alignItems="Center">
                                    <Label text="입고문서" class="qrInfoLabel"/>
                                    <Text id="dMblnr" text="" class="qrInfoVal"/>
                                </HBox>
                                <HBox class="qrInfoRow" alignItems="Center">
                                    <Label text="배치번호" class="qrInfoLabel"/>
                                    <Text id="dCharg" text="" class="qrInfoVal"/>
                                </HBox>
                                <HBox class="qrInfoRow" alignItems="Center">
                                    <Label text="공급업체" class="qrInfoLabel"/>
                                    <Text id="dVenName" text="" class="qrInfoVal"/>
                                </HBox>
                            </VBox>

                            <!-- 입고 요약 (상세 표는 재고조회에서) -->
                            <VBox class="qrInfoSection">
                                <Title text="입고 요약" level="H5" class="qrSectionTitle"/>
                                <HBox class="qrInfoRow" alignItems="Center">
                                    <Label text="입고 건수" class="qrInfoLabel"/>
                                    <Text id="dGrCount" text="-" class="qrInfoVal"/>
                                </HBox>
                                <HBox class="qrInfoRow" alignItems="Center">
                                    <Label text="누적 입고" class="qrInfoLabel"/>
                                    <Text id="dGrSum" text="-" class="qrInfoVal"/>
                                </HBox>
                                <HBox class="qrInfoRow" alignItems="Center">
                                    <Label text="입고 기간" class="qrInfoLabel"/>
                                    <Text id="dGrPeriod" text="-" class="qrInfoVal"/>
                                </HBox>
                            </VBox>

                          </VBox>

                            <!-- ACTION BAR (하단 고정 - 스크롤 영역 밖) -->
                            <OverflowToolbar id="detailActionBar" class="qrActionBar">
                                <ToolbarSpacer/>
                                <Button id="btnIssueQr" text="QR 발행" type="Emphasized" icon="sap-icon://print" press="onIssueQr"/>
                                <Button id="btnReIssue" text="재발행" type="Default" icon="sap-icon://refresh" press="onReIssueQr" visible="false"/>
                            </OverflowToolbar>

                        </VBox>

                    </VBox>

                </HBox>

                    </IconTabFilter>

                    <!-- ════════ TAB 2 : QR 스캔 (배치 중심) ════════ -->
                    <IconTabFilter id="tabScan" text="QR 스캔" key="scan" icon="sap-icon://bar-code">
                        <mvc:XMLView viewName="c1.mm.c1mmqr.view.qrScanView" height="100%"/>
                    </IconTabFilter>

                    <!-- ════════ TAB 3 : 창고 현황 대시보드 ════════ -->
                    <IconTabFilter text="창고 현황" key="lookup" icon="sap-icon://inventory">

                        <HBox renderType="Bare" class="qrDashWrap">

                            <!-- LEFT : 스캔/조회 + 이력 -->
                            <VBox class="qrDashLeft">

                                <VBox class="qrDashCard qrCardSearch">
                                    <Title text="자재 조회" level="H5" class="qrDashCardTitle"/>
                                    <Label text="자재번호 입력 (창고별 재고·위치 조회)" class="qrDashHint sapUiSmallMarginTop"/>
                                    <HBox alignItems="Center" class="sapUiTinyMarginTop">
                                        <Input id="inDashQuery" placeholder="자재번호" width="100%" submit="onDashSearch" showValueHelp="true" valueHelpRequest="onVHDashMatnr"/>
                                        <Button icon="sap-icon://search" type="Emphasized" press="onDashSearch" class="sapUiTinyMarginBegin"/>
                                    </HBox>
                                    <Button
                                        text="초기화"
                                        icon="sap-icon://undo"
                                        type="Emphasized" press="onDashReset"
                                        width="100%"
                                        class="sapUiTinyMarginTop"/>
                                </VBox>

                                <VBox class="qrDashCard sapUiSmallMarginTop">
                                    <Title text="조회 이력" level="H5" class="qrDashCardTitle"/>
                                    <List id="dashHistList" noDataText="조회 이력 없음" class="qrDashHistList"/>
                                </VBox>

                            </VBox>

                            <!-- RIGHT : KPI + 자재정보 + 창고별 재고 -->
                            <VBox class="qrDashRight">

                                <!-- KPI CARDS -->
                                <Text text="자재 전체 재고 (모든 배치 합산)" class="qrScopeCaption"/>
                                <HBox renderType="Bare" class="qrDashKpis">
                                    <VBox class="qrDashKpiCard">
                                        <Text text="총재고" class="qrDashKpiLabel"/>
                                        <Title id="dkTotal" text="-" level="H2" class="qrDashKpiValue"/>
                                    </VBox>
                                    <VBox class="qrDashKpiCard">
                                        <Text text="가용재고" class="qrDashKpiLabel"/>
                                        <Title id="dkClabs" text="-" level="H2" class="qrDashKpiValue qrDashKpiValue--green"/>
                                    </VBox>
                                    <VBox class="qrDashKpiCard">
                                        <Text text="품질검사중" class="qrDashKpiLabel"/>
                                        <Title id="dkCinsm" text="-" level="H2" class="qrDashKpiValue qrDashKpiValue--warn"/>
                                    </VBox>
                                    <VBox class="qrDashKpiCard">
                                        <Text text="보류재고" class="qrDashKpiLabel"/>
                                        <Title id="dkCspem" text="-" level="H2" class="qrDashKpiValue qrDashKpiValue--red"/>
                                    </VBox>
                                </HBox>

                                <!-- 2행: 자재정보 + 창고별 재고 (나란히) -->
                                <HBox renderType="Bare" class="qrDashRow sapUiSmallMarginTop">

                                    <VBox id="dashMatCard" class="qrDashCard qrDashHalf qrCardMat" visible="false">
                                        <Title text="자재 정보" level="H5" class="qrDashCardTitle"/>
                                        <VBox class="qrMatGrid sapUiTinyMarginTop">
                                            <VBox class="qrDashImgBox qrMatImg">
                                                <Image
                                                    id="dashMatImg"
                                                    width="8rem"
                                                    densityAware="false"
                                                    error="onDashImgError"/>
                                                <core:Icon
                                                    id="dashMatImgFallback"
                                                    src="sap-icon://product"
                                                    size="4rem"
                                                    color="#B0B8C1"
                                                    visible="false"
                                                    class="qrDashImgFallback"/>
                                            </VBox>
                                            <VBox class="qrMatName">
                                                <Title id="dashMatTitle" text="" level="H4" wrapping="true"/>
                                            </VBox>
                                            <VBox class="qrMatExtra">
                                                <HBox class="qrInfoRow" alignItems="Center">
                                                    <Label text="자재코드" class="qrInfoLabel"/>
                                                    <Text id="dashMatnr" text="" class="qrInfoVal"/>
                                                </HBox>
                                                <HBox class="qrInfoRow" alignItems="Center">
                                                    <Label text="단위" class="qrInfoLabel"/>
                                                    <Text id="dashMeins" text="" class="qrInfoVal"/>
                                                </HBox>
                                            </VBox>
                                        </VBox>
                                    </VBox>

                                    <VBox class="qrDashCard qrDashHalf qrCardStock">
                                        <Title text="창고별 재고 현황" level="H5" class="qrDashCardTitle"/>
                                        <Table id="dashStockTable" noDataText="조회된 재고가 없습니다." fixedLayout="false" class="qrDashStockTable">
                                            <columns>
                                                <Column><Text text="창고"/></Column>
                                                <Column hAlign="Right"><Text text="가용재고"/></Column>
                                                <Column hAlign="Right"><Text text="검사중"/></Column>
                                                <Column hAlign="Right"><Text text="보류"/></Column>
                                                <Column hAlign="Right"><Text text="총재고"/></Column>
                                                <Column hAlign="Center" width="5rem"><Text text="상태"/></Column>
                                            </columns>
                                        </Table>
                                    </VBox>

                                </HBox>

                                <!-- 3행: 차트 + 창고배치도 + 입고예정 -->
                                <HBox renderType="Bare" class="qrDashRow qrDashRowViz sapUiSmallMarginTop">

                                    <VBox class="qrDashCard qrDashThird qrCardChart" renderType="Bare">
                                        <Title text="재고 분포 차트" level="H5" class="qrDashCardTitle"/>
                                        <core:HTML id="dashChartHtml" preferDOM="false"
                                            content="&lt;div class='qrChartEmpty'&gt;자재를 조회하면 차트가 표시됩니다&lt;/div&gt;"/>
                                    </VBox>

                                    <VBox class="qrDashCard qrDashThird qrCardEta">
                                        <Title text="가용재고 전환 예정" level="H5" class="qrDashCardTitle"/>
                                        <VBox id="dashEtaBox" class="sapUiTinyMarginTop qrEtaBox">
                                            <Text text="자재를 조회하면 예측이 표시됩니다" class="qrChartEmpty"/>
                                        </VBox>
                                    </VBox>

                                </HBox>

                                <!-- 3.5행: 3D 창고 배치도 (전체폭) + 클릭 시 배치 목록 -->
                                <VBox class="qrDashCard sapUiSmallMarginTop qrCardMap3d">
                                    <Title text="창고 배치도 (자재 전체)" level="H5" class="qrDashCardTitle"/>
                                    <HBox renderType="Bare" class="qrMap3dWrap sapUiTinyMarginTop">
                                        <core:HTML id="dashMapHtml" preferDOM="false"
                                            content="&lt;div class='qrChartEmpty'&gt;자재를 조회하면 위치가 표시됩니다&lt;/div&gt;"/>
                                        <VBox id="dashWhBatchBox" class="qrWhBatchPanel" visible="false">
                                            <HBox alignItems="Center" width="100%" justifyContent="SpaceBetween">
                                                <Title id="dashWhBatchTitle" text="" level="H6" class="qrDashCardTitle"/>
                                                <Button icon="sap-icon://decline" type="Transparent" tooltip="닫기" press="onWhBatchClose"/>
                                            </HBox>
                                            <List id="dashWhBatchList" noDataText="배치 없음" class="qrWhBatchList sapUiTinyMarginTop"/>
                                        </VBox>
                                    </HBox>
                                </VBox>

                            </VBox>

                        </HBox>

                    </IconTabFilter>

                    </items>
                </IconTabBar>

            </VBox>
        </content>
    </Page>
</mvc:View>
