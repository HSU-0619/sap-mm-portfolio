<mvc:View
    controllerName="c1.mm.c1mmpoappr.controller.approvalView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    displayBlock="true">

    <Page
        id="mainPage"
        showHeader="false"
        showNavButton="false"
        enableScrolling="false"
        class="sapUiNoContentPadding poApprMain">

        <content>
            <VBox id="poRoot" class="poRoot">


                <!-- TOP FILTER BAR (가로 조회조건) -->
                <VBox id="filterTop" class="poFilterTop">

                    <Toolbar class="poPanelHeader">
                        <Title text="조회 조건" level="H5"/>
                        <ToolbarSpacer/>
                    </Toolbar>

                    <HBox class="poFilterTopBody" alignItems="End" wrap="Wrap">

                        <VBox class="poFilterField">
                            <Label text="구매오더 번호"/>
                            <Input
                                id="sfPoNo"
                                placeholder="구매오더번호 입력"
                                width="220px"
                                showValueHelp="true"
                                valueHelpRequest="onPoNoValueHelp"
                                submit="onSearch"/>
                        </VBox>

                        <VBox class="poFilterField">
                            <Label text="공급업체"/>
                            <Input
                                id="inVendor"
                                placeholder="공급업체번호 입력"
                                width="220px"
                                showValueHelp="true"
                                valueHelpRequest="onVendorValueHelp"
                                submit="onSearch"/>
                        </VBox>

                        <VBox class="poFilterField">
                            <Label text="구매오더 생성일"/>
                            <HBox alignItems="Center">
                                <DatePicker
                                    id="dpFrom"
                                    placeholder="시작일"
                                    width="160px"
                                    valueFormat="yyyyMMdd"
                                    displayFormat="yyyy-MM-dd"/>
                                <Text text="~" class="poDateTilde sapUiTinyMarginBegin sapUiTinyMarginEnd"/>
                                <DatePicker
                                    id="dpTo"
                                    placeholder="종료일"
                                    width="160px"
                                    valueFormat="yyyyMMdd"
                                    displayFormat="yyyy-MM-dd"/>
                            </HBox>
                        </VBox>

                        <VBox class="poFilterSpacer">
                            <layoutData><FlexItemData growFactor="1"/></layoutData>
                        </VBox>

                        <VBox class="poFilterField">
                            <Label text=" "/>
                            <HBox>
                                <Button
                                    text="조회"
                                    type="Emphasized"
                                    icon="sap-icon://search"
                                    press="onSearch"/>
                                <Button
                                    text="초기화"
                                    type="Emphasized"
                                    icon="sap-icon://undo"
                                    press="onReset"
                                    class="sapUiTinyMarginBegin"/>
                            </HBox>
                        </VBox>

                        <!-- 상태 필터는 KPI 알약버튼으로 대체 (숨김 유지: 컨트롤러 로직 호환) -->
                        <Select id="selStatu" visible="false" selectedKey="ALL">
                            <core:Item key="ALL" text="전체"/>
                            <core:Item key="ING" text="결재대기"/>
                            <core:Item key="AP" text="승인"/>
                            <core:Item key="RJ" text="반려"/>
                        </Select>

                    </HBox>
                </VBox>

                <!-- MAIN WORK AREA -->
                <HBox id="workArea" renderType="Bare" class="poWorkArea">

                    <!-- CENTER LIST -->
                    <VBox id="listPanel" class="poListPanel">

                        <Toolbar class="poPanelHeader">
                            <VBox>
                                <Title id="listHeader" text="결재 리스트" level="H5"/>
                                <Text id="listSubHeader" text="전결/일반결재 대상 구매오더" class="poPanelSubText"/>
                            </VBox>

                            <ToolbarSpacer/>

                            <CheckBox
                                id="cbSelectAll"
                                text="전체 선택"
                                select="onSelectAllCheck"
                                class="sapUiTinyMarginEnd"/>

                            <Button
                                id="btnBulkApprove"
                                text="일괄 승인"
                                type="Emphasized"
                                icon="sap-icon://multi-select"
                                press="onBulkApprove"
                                enabled="false"/>

                            <Button icon="sap-icon://sort" type="Transparent" tooltip="정렬" press="onSortPress"/>
                        </Toolbar>

                        <!-- KPI 알약 필터 -->
                        <HBox id="kpiStrip" class="poKpiPills" wrap="Wrap">

                            <VBox id="kpiCardAll" class="poKpiPill poKpiPill--active">
                                <HBox alignItems="Center" justifyContent="Center">
                                    <Text text="전체" class="poKpiLabel"/>
                                    <Title id="kpiAllCnt" text="0" level="H5" class="poKpiValue sapUiTinyMarginBegin"/>
                                </HBox>
                                <Text id="kpiAllAmt" text="합계 -" class="poKpiHint poKpiHint--amt"/>
                            </VBox>

                            <VBox id="kpiCardING" class="poKpiPill">
                                <HBox alignItems="Center" justifyContent="Center">
                                    <Text text="결재대기" class="poKpiLabel"/>
                                    <Title id="kpiIngCnt" text="0" level="H5" class="poKpiValue poKpiValue--warn sapUiTinyMarginBegin"/>
                                </HBox>
                                <Text id="kpiIngAmt" text="합계 -" class="poKpiHint poKpiHint--amt"/>
                            </VBox>

                            <VBox id="kpiCardAP" class="poKpiPill">
                                <HBox alignItems="Center" justifyContent="Center">
                                    <Text text="승인" class="poKpiLabel"/>
                                    <Title id="kpiApCnt" text="0" level="H5" class="poKpiValue poKpiValue--green sapUiTinyMarginBegin"/>
                                </HBox>
                                <Text id="kpiApAmt" text="합계 -" class="poKpiHint poKpiHint--amt"/>
                            </VBox>

                            <VBox id="kpiCardRJ" class="poKpiPill">
                                <HBox alignItems="Center" justifyContent="Center">
                                    <Text text="반려" class="poKpiLabel"/>
                                    <Title id="kpiRjCnt" text="0" level="H5" class="poKpiValue poKpiValue--red sapUiTinyMarginBegin"/>
                                </HBox>
                                <Text id="kpiRjAmt" text="합계 -" class="poKpiHint poKpiHint--amt"/>
                            </VBox>

                        </HBox>

                        <VBox id="poListBody" class="poListBody">
                            <List
                                id="poList"
                                mode="MultiSelect"
                                includeItemInSelection="false"
                                selectionChange="onSelectionChange"
                                noDataText="조회된 구매오더가 없습니다."
                                growing="false"
                                class="poWorkList"/>
                        </VBox>

                    </VBox>

                    <!-- RIGHT DETAIL -->
                    <VBox id="rightArea" class="poRightArea">

                        <VBox id="emptyDetail" class="poEmptyDetail" alignItems="Center" justifyContent="Center">
                            <core:Icon src="sap-icon://detail-view" size="3rem" color="#B0B8C1"/>
                            <Title text="구매오더를 선택하세요" level="H4" class="sapUiSmallMarginTop"/>
                            <Text
                                text="중앙 결재 리스트에서 구매오더를 선택하면 상세 정보와 결재 처리 버튼이 표시됩니다."
                                textAlign="Center"
                                wrapping="true"/>
                        </VBox>

                        <VBox id="detailPanel" visible="false" class="poDetailPanel" renderType="Bare">

                            <!-- DETAIL HEADER -->
                            <VBox class="poDetailHeader">
                                <HBox justifyContent="SpaceBetween" alignItems="Start">
                                    <VBox>
                                        <HBox alignItems="Center">
                                            <Title id="dHdrEbeln" text="" level="H2" class="poDetailNo"/>

                                            <core:HTML
                                                id="dHdrBadge"
                                                content=""
                                                preferDOM="false"
                                                class="sapUiSmallMarginBegin"/>
                                        </HBox>

                                        <Text id="dHdrVendor" text="" class="poDetailVendor"/>
                                    </VBox>

                                    <VBox alignItems="End">
                                        <Text id="dHdrPlant" text="" class="poDetailMeta"/>
                                        <Text id="dHdrDate" text="" class="poDetailMeta"/>
                                        <Text id="dHdrAmt" text="" class="poDetailAmount"/>
                                    </VBox>
                                </HBox>
                            </VBox>

                            <IconTabBar
                                id="detailTabMain"
                                selectedKey="overview"
                                expandable="false"
                                backgroundDesign="Transparent"
                                select="onTabSelect"
                                class="poDetailTabs">

                                <items>
                                    <IconTabFilter text="개요" key="overview"/>
                                    <IconTabFilter text="품목" key="items"/>
                                    <IconTabFilter text="결재이력" key="history"/>
                                    <IconTabFilter text="PDF" key="pdf"/>
                                </items>

                                <content>

                                    <!-- OVERVIEW -->
                                    <VBox id="tabOverview" class="poTabContent">

                                        <VBox class="poOverviewGrid">

                                            <!-- 1. 구매 사유 (최상단) -->
                                            <HBox class="poReasonCard" alignItems="Start">
                                                <Text text="✦" class="poReasonSpark"/>
                                                <VBox class="poReasonBody">
                                                    <Text text="왜 구매하나요?" class="poReasonKicker"/>
                                                    <Text id="dReasonTitle" text="" class="poReasonMain"/>
                                                    <Text id="dReasonText" text="" wrapping="true" class="poReasonDesc"/>
                                                </VBox>
                                            </HBox>

                                            <!-- 반려 사유 (반려건만) -->
                                            <VBox id="rejectInfoPanel" visible="false" class="poRejectCard">
                                                <Text text="반려 사유" class="poReasonKicker poReasonKicker--red"/>
                                                <Text id="dBaseBigo" text="" wrapping="true" class="poRejectText"/>
                                            </VBox>

                                            <!-- 2. 기본 정보 타일 -->
                                            <HBox class="poInfoGrid" wrap="Wrap">
                                                <VBox class="poInfoTile">
                                                    <Text text="구매오더유형" class="poTileLabel"/>
                                                    <Text id="dBaseBsart" text="" class="poTileVal"/>
                                                </VBox>
                                                <VBox class="poInfoTile">
                                                    <Text text="상신자" class="poTileLabel"/>
                                                    <Text id="dBaseErnam" text="" class="poTileVal"/>
                                                </VBox>
                                                <VBox class="poInfoTile">
                                                    <Text text="상신일자" class="poTileLabel"/>
                                                    <Text id="dBaseErdat" text="" class="poTileVal"/>
                                                </VBox>
                                                <VBox class="poInfoTile">
                                                    <Text text="결재 상태" class="poTileLabel"/>
                                                    <Text id="dBaseStatus" text="" class="poTileVal poTileVal--blue"/>
                                                </VBox>
                                            </HBox>

                                            <!-- 3. 자재부족 품목 -->
                                            <VBox class="poSectionCard">
                                                <HBox class="poSectionHead" justifyContent="SpaceBetween" alignItems="Center">
                                                    <Text text="자재부족 품목" class="poSectionTitle"/>
                                                    <Text text="MRP 기준 부족 수량" class="poSectionSub"/>
                                                </HBox>
                                                <ScrollContainer
                                                    width="100%"
                                                    horizontal="true"
                                                    vertical="false"
                                                    focusable="false"
                                                    class="poTableScroll">

                                                    <Table
                                                        id="mrpMiniTable"
                                                        noDataText="MRP 근거 데이터가 없습니다."
                                                        class="poMrpScrollTable poAutoWidthTable"
                                                        width="auto"
                                                        fixedLayout="false">

                                                        <columns>
                                                            <Column width="8.5rem">
                                                                <Text text="자재번호" wrapping="false"/>
                                                            </Column>

                                                            <Column width="8rem">
                                                                <Text text="품명" wrapping="false"/>
                                                            </Column>

                                                            <Column width="6rem" hAlign="Right">
                                                                <Text text="발주수량" wrapping="false"/>
                                                            </Column>

                                                            <Column width="8.5rem" hAlign="Center">
                                                                <Text text="PR번호" wrapping="false"/>
                                                            </Column>
                                                        </columns>
                                                    </Table>

                                                </ScrollContainer>
                                            </VBox>

                                        </VBox>

                                    </VBox>

                                    <!-- ITEMS -->
                                    <VBox id="tabItems" class="poTabContent" visible="false">

                                        <HBox class="poSummaryStrip" wrap="Wrap">
                                            <VBox class="poSummaryCard">
                                                <Text text="총 발주금액" class="poSumLabel"/>
                                                <Text id="dItemSumAmt" text="-" class="poSumValue poSumValue--red"/>
                                                <Text text="VAT 제외 기준" class="poSumSub"/>
                                            </VBox>
                                            <VBox class="poSummaryCard">
                                                <Text text="품목 수" class="poSumLabel"/>
                                                <Text id="dItemSumCnt" text="-" class="poSumValue"/>
                                                <Text text="구매오더 품목" class="poSumSub"/>
                                            </VBox>
                                            <VBox class="poSummaryCard">
                                                <Text text="최단 납기일" class="poSumLabel"/>
                                                <Text id="dItemSumDate" text="-" class="poSumValue"/>
                                                <Text text="납기 예정일" class="poSumSub"/>
                                            </VBox>
                                        </HBox>

                                        <ScrollContainer
                                            width="100%"
                                            horizontal="true"
                                            vertical="false"
                                            focusable="false"
                                            class="poTableScroll poItemTableScroll">

                                            <Table
                                                id="itemTableMain"
                                                noDataText="품목 정보가 없습니다."
                                                class="poDataTable poItemScrollTable poAutoWidthTable"
                                                width="100%"
                                                fixedLayout="false">

                                                <headerToolbar>
                                                    <Toolbar>
                                                        <Title text="구매오더 품목" level="H5"/>
                                                        <ToolbarSpacer/>
                                                        <SearchField id="itemSearch" width="220px" placeholder="품목 검색" liveChange="onItemSearch"/>
                                                    </Toolbar>
                                                </headerToolbar>

                                                <columns>
                                                    <Column hAlign="Center">
                                                        <Text text="품목번호" wrapping="false"/>
                                                    </Column>

                                                    <Column>
                                                        <Text text="품명" wrapping="false"/>
                                                    </Column>

                                                    <Column hAlign="Right">
                                                        <Text text="수량" wrapping="false"/>
                                                    </Column>

                                                    <Column hAlign="Right">
                                                        <Text text="단가" wrapping="false"/>
                                                    </Column>

                                                    <Column hAlign="Center">
                                                        <Text text="납기일" wrapping="false"/>
                                                    </Column>

                                                    <Column hAlign="Center">
                                                        <Text text="PR번호" wrapping="false"/>
                                                    </Column>

                                                    <Column>
                                                        <Text text="구매사유" wrapping="false"/>
                                                    </Column>
                                                </columns>
                                            </Table>

                                        </ScrollContainer>
                                    </VBox>

                                    <!-- HISTORY (결재서명 위 / 결재의견 아래) -->
                                    <VBox id="tabHistory" class="poTabContent" visible="false">
                                        <VBox class="poSectionCard">
                                            <Text text="결재 서명" class="poSectionTitle"/>
                                            <HBox id="stampBoxFull" class="poStampBox" wrap="NoWrap"/>
                                        </VBox>

                                        <VBox class="poSectionCard sapUiSmallMarginTop">
                                            <Text text="결재 의견" class="poSectionTitle"/>
                                            <List
                                                id="historyList"
                                                noDataText="결재 의견이 없습니다."
                                                class="poHistoryList"/>
                                        </VBox>
                                    </VBox>

                                    <!-- PDF -->
                                    <VBox id="tabPdf" class="poTabContent poPdfTab" visible="false">
                                        <HBox class="poPdfTopBar" alignItems="Center" justifyContent="SpaceBetween">
                                            <VBox class="poPdfTopInfo">
                                                <Title text="결재서 미리보기" level="H5" class="poPdfSideTitle"/>
                                                <Text text="출력용 문서는 승인 이력과 품목 금액을 기준으로 자동 생성됩니다." class="poPdfSideDesc"/>
                                            </VBox>
                                            <HBox class="poPdfTopBtns" alignItems="Center">
                                                <Button
                                                    text="인쇄"
                                                    type="Emphasized"
                                                    icon="sap-icon://print"
                                                    press="onGeneratePdf"/>
                                            </HBox>
                                        </HBox>

                                        <VBox class="poPdfMain sapUiSmallMarginTop">
                                            <core:HTML
                                                id="pdfPreviewHtml"
                                                preferDOM="true"
                                                content="&lt;div id='pdfPreviewBox' class='poPdfPreviewBox'&gt;&lt;div class='poPdfEmpty'&gt;구매오더를 선택하면 결재서 미리보기가 표시됩니다.&lt;/div&gt;&lt;/div&gt;"/>
                                        </VBox>
                                    </VBox>

                                </content>
                            </IconTabBar>

                            <OverflowToolbar id="actionBar" class="poActionBar" visible="true">
                                <Text id="actionHint" text="결재 처리 가능 상태입니다." class="poActionHint"/>
                                <ToolbarSpacer/>
                                <Button id="btnReject" text="반려" type="Reject" icon="sap-icon://decline" press="onReject"/>
                                <Button id="btnApprove" text="승인" type="Accept" icon="sap-icon://accept" press="onApprove" class="poApproveBtn"/>
                            </OverflowToolbar>

                        </VBox>

                    </VBox>

                </HBox>

            </VBox>
        </content>
    </Page>
</mvc:View>
