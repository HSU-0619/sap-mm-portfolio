{
  "_version": "1.60.0",
  "sap.app": {
    "id": "c1.mm.c1mmpoappr",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": { "version": "0.0.1" },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata/sap/ZRAP_C1_MM_0001_BIND/",
        "type": "OData",
        "settings": {
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "2.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.f": {}
      }
    },
    "contentDensities": { "compact": true, "cozy": true },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": { "bundleName": "c1.mm.c1mmpoappr.i18n.i18n" }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {}
      },
      "kpiModel": {
        "type": "sap.ui.model.json.JSONModel",
        "settings": { "data": { "pdCount": "0건", "ftCount": "0건", "apCount": "0건", "rjCount": "0건" } }
      }
    },
    "resources": { "css": [{ "uri": "css/style.css" }] },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "type": "View",
        "viewType": "XML",
        "path": "c1.mm.c1mmpoappr.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "async": true
      },
      "routes": [
        {
          "name": "RouteapprovalView",
          "pattern": ":?query:",
          "target": ["TargetapprovalView"]
        },
        {
          "name": "RouteApprovalDetail",
          "pattern": "detail/{poDocNo}",
          "target": ["TargetApprovalDetail"]
        }
      ],
      "targets": {
        "TargetapprovalView": {
          "id": "approvalView",
          "name": "approvalView"
        },
        "TargetApprovalDetail": {
          "id": "approvalDetail",
          "name": "ApprovalDetail"
        }
      }
    },
    "rootView": {
      "viewName": "c1.mm.c1mmpoappr.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
