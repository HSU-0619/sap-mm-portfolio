.poRail {                                                                                                                                                                                                                                                      
  position: absolute !important;                                                                                                                                                                                                                               
  top: 5.2rem !important;                                                                                                                                                                                                                                      
  left: 0 !important;                                                                                                                                                                                                                                          
  bottom: 0 !important;                                                                                                                                                                                                                                        
  width: 110px !important;                                                                                                                                                                                                                                     
  box-sizing: border-box !important;                                                                                                                                                                                                                           
  padding: 12px 0 !important;                                                                                                                                                                                                                                  
  background: #16223A !important;                                                                                                                                                                                                                              
  border-right: 1px solid #2C3A57 !important;                                                                                                                                                                                                                  
  z-index: 3 !important;                                                                                                                                                                                                                                       
}                                                                                                                                                                                                                                                              
.poRailBtn.sapMBtn {                                                                                                                                                                                                                                           
  width: calc(100% - 16px) !important;                                                                                                                                                                                                                         
  min-width: 0 !important;                                                                                                                                                                                                                                     
  margin: 4px 8px !important;                                                                                                                                                                                                                                  
  height: auto !important;                                                                                                                                                                                                                                     
}                                                                                                                                                                                                                                                              
.poRailBtn .sapMBtnInner {                                                                                                                                                                                                                                     
  display: flex !important;                                                                                                                                                                                                                                    
  flex-direction: column !important;                                                                                                                                                                                                                           
  align-items: center !important;                                                                                                                                                                                                                              
  justify-content: center !important;                                                                                                                                                                                                                          
  gap: 4px !important;                                                                                                                                                                                                                                         
  height: auto !important;                                                                                                                                                                                                                                     
  min-width: 0 !important;                                                                                                                                                                                                                                     
  padding: 12px 4px !important;                                                                                                                                                                                                                                
  background: transparent !important;                                                                                                                                                                                                                          
  border: 1px solid transparent !important;                                                                                                                                                                                                                    
  border-radius: 8px !important;                                                                                                                                                                                                                               
  box-shadow: none !important;                                                                                                                                                                                                                                 
}                                                                                                                                                                                                                                                              
.poRailBtn .sapMBtnIcon { color: #9FB0C8 !important; font-size: 1.4rem !important; }                                                                                                                                                                           
.poRailBtn .sapMBtnContent,                                                                                                                                                                                                                                    
.poRailBtn .sapMBtnContent bdi { color: #9FB0C8 !important; font-size: .8rem !important; font-weight: 600 !important; }                                                                                                                                        
.poRailBtn:hover .sapMBtnInner { background: #243352 !important; }                                                                                                                                                                                             
.poRailBtn--active .sapMBtnInner {                                                                                                                                                                                                                             
  background: #2A2418 !important;                                                                                                                                                                                                                              
  border-color: #5A4A22 !important;                                                                                                                                                                                                                            
  border-left: 3px solid #E8B547 !important;                                                                                                                                                                                                                   
}                                                                                                                                                                                                                                                              
.poRailBtn--active .sapMBtnIcon,                                                                                                                                                                                                                               
.poRailBtn--active .sapMBtnContent,                                                                                                                                                                                                                            
.poRailBtn--active .sapMBtnContent bdi { color: #E8B547 !important; }                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
/* 결재리스트 ↔ 상세영역 간격 */                                                                                                                                                                                                                                          
.poDetailPanel,                                                                                                                                                                                                                                                
.poEmptyDetail { left: 14px !important; }                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
/* ============================================================                                                                                                                                                                                                
   상세 콘텐츠: 칸에 딱 맞추고 세로 스크롤                                                                                                                                                                                                                                     
   ============================================================ */                                                                                                                                                                                             
/* 스크롤 컨테이너 체인 높이 보장 */                                                                                                                                                                                                                                        
.poDetailTabs .sapMITBContainerContent,                                                                                                                                                                                                                        
.poDetailTabs .sapMITBContent,                                                                                                                                                                                                                                 
.poDetailTabs .sapMITBContentPadding {                                                                                                                                                                                                                         
  height: 100% !important;                                                                                                                                                                                                                                     
  max-height: 100% !important;                                                                                                                                                                                                                                 
  width: 100% !important;                                                                                                                                                                                                                                      
  max-width: 100% !important;                                                                                                                                                                                                                                  
  overflow: hidden !important;                                                                                                                                                                                                                                 
  padding: 0 !important;                                                                                                                                                                                                                                       
  box-sizing: border-box !important;                                                                                                                                                                                                                           
}                                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
/* 실제 내용: 세로 스크롤 / 가로는 칸에 맞춤 */                                                                                                                                                                                                                                
.poTabContent {                                                                                                                                                                                                                                                
  height: 100% !important;                                                                                                                                                                                                                                     
  max-height: 100% !important;                                                                                                                                                                                                                                 
  width: 100% !important;                                                                                                                                                                                                                                      
  max-width: 100% !important;                                                                                                                                                                                                                                  
  overflow-y: auto !important;                                                                                                                                                                                                                                 
  overflow-x: hidden !important;                                                                                                                                                                                                                               
  padding: 0.85rem 1rem 1.5rem 1rem !important;                                                                                                                                                                                                                
  box-sizing: border-box !important;                                                                                                                                                                                                                           
}                                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
/* 내부 카드/패널/그리드가 가로로 넘치지 않게 */                                                                                                                                                                                                                                 
.poTabContent .poOverviewGrid,                                                                                                                                                                                                                                 
.poTabContent .poOverviewTop,                                                                                                                                                                                                                                  
.poTabContent .poOverviewBottomGrid,                                                                                                                                                                                                                           
.poTabContent .poCardPanel,                                                                                                                                                                                                                                    
.poTabContent .poReasonPanel,                                                                                                                                                                                                                                  
.poTabContent .poRejectPanel,                                                                                                                                                                                                                                  
.poTabContent .poInfoRows,                                                                                                                                                                                                                                     
.poTabContent .sapMPanel {                                                                                                                                                                                                                                     
  width: 100% !important;                                                                                                                                                                                                                                      
  max-width: 100% !important;                                                                                                                                                                                                                                  
  box-sizing: border-box !important;                                                                                                                                                                                                                           
  min-width: 0 !important;                                                                                                                                                                                                                                     
}                                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
/* 표는 칸을 넘으면 자체 가로 스크롤(잘리지 않게) */                                                                                                                                                                                                                              
.poTabContent .sapMListTbl,                                                                                                                                                                                                                                    
.poTabContent .sapMList,                                                                                                                                                                                                                                       
.poTabContent .poDataTable {                                                                                                                                                                                                                                   
  width: 100% !important;                                                                                                                                                                                                                                      
  max-width: 100% !important;                                                                                                                                                                                                                                  
  box-sizing: border-box !important;                                                                                                                                                                                                                           
}                                                                                                                                                                                                                                                              
.poTabContent .sapMListUl { min-width: 0 !important; }                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
/* ============================================================                                                                                                                                                                                                
   상세 탭 우측 잘림 수정 (IconTabBar 인라인 width:100% 무력화)                                                                                                                                                                                                               
   ============================================================ */                                                                                                                                                                                             
.poDetailTabs,                                                                                                                                                                                                                                                 
.poDetailTabs.sapMITB {                                                                                                                                                                                                                                        
  width: auto !important;   /* left:110 + right:0 으로 폭 결정 (인라인 100% 무시) */                                                                                                                                                                                     
}                                                                                                                                                                                                                                                              
.poDetailTabs .sapMITBContainerContent {                                                                                                                                                                                                                       
  width: auto !important;                                                                                                                                                                                                                                      
}                                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
/* 내용이 패널보다 넓으면 가로 스크롤바 표시 (잘리지 않게) */                                                                                                                                                                                                                         
.poTabContent {                                                                                                                                                                                                                                                
  overflow-x: auto !important;                                                                                                                                                                                                                                 
  overflow-y: auto !important;                                                                                                                                                                                                                                 
}                                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
/* 좌측 레일: 버튼이 세로로 다 들어오도록 + 넘치면 스크롤 */                                                                                                                                                                                                                         
.poRail {                                                                                                                                                                                                                                                      
  bottom: 3.2rem !important;                                                                                                                                                                                                                                   
  overflow-y: auto !important;                                                                                                                                                                                                                                 
  padding: 8px 0 !important;                                                                                                                                                                                                                                   
}                                                                                                                                                                                                                                                              
.poRailBtn .sapMBtnInner {                                                                                                                                                                                                                                     
  padding: 9px 4px !important;                                                                                                                                                                                                                                 
  gap: 3px !important;                                                                                                                                                                                                                                         
}                                                                                                                                                                                                                                                              
.poRailBtn .sapMBtnIcon { font-size: 1.25rem !important; }                                                                                                                                                                                                     
.poRailBtn .sapMBtnContent,                                                                                                                                                                                                                                    
.poRailBtn .sapMBtnContent bdi { font-size: .75rem !important; }                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
/* 레일 스크롤바 제거 + 4개 버튼 균등 배치 */                                                                                                                                                                                                                                 
.poRail {                                                                                                                                                                                                                                                      
  overflow: hidden !important;                                                                                                                                                                                                                                 
  justify-content: space-between !important;                                                                                                                                                                                                                   
  padding: 10px 0 !important;                                                                                                                                                                                                                                  
}                                                                                                                                                                                                                                                              
.poRailBtn.sapMBtn { margin: 2px 8px !important; }                                                                                                                                                                                                             
.poRailBtn .sapMBtnInner { padding: 7px 4px !important; }                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
/* 품목 표: 내용 길이에 따라 컬럼 자동 조정 + 패널 폭에 맞춤 (가로 스크롤 최소화) */                                                                                                                                                                                                         
.poItemScrollTable.poAutoWidthTable,                                                                                                                                                                                                                           
.poItemScrollTable .sapMListTblCnt,                                                                                                                                                                                                                            
.poItemScrollTable .sapMListTbl {                                                                                                                                                                                                                              
  width: 100% !important;                                                                                                                                                                                                                                      
  min-width: 0 !important;                                                                                                                                                                                                                                     
  max-width: 100% !important;                                                                                                                                                                                                                                  
  table-layout: auto !important;                                                                                                                                                                                                                               
}                                                                                                                                                                                                                                                              
/* 셀은 내용 폭 기준이되 표가 100%를 넘지 않도록 강제 폭 해제 */                                                                                                                                                                                                                     
.poItemScrollTable .sapMListTblHeaderCell .sapMText,                                                                                                                                                                                                           
.poItemScrollTable .sapMListTblCell .sapMText {                                                                                                                                                                                                                
  min-width: 0 !important;                                                                                                                                                                                                                                     
  width: auto !important;                                                                                                                                                                                                                                      
}                                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               