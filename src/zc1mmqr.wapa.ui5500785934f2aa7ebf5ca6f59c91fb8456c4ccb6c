sap.ui.define(                                                                                                                                                                                                                                                 
  [                                                                                                                                                                                                                                                            
    "sap/ui/core/mvc/Controller",                                                                                                                                                                                                                              
    "sap/ui/model/Filter",                                                                                                                                                                                                                                     
    "sap/ui/model/FilterOperator",                                                                                                                                                                                                                             
    "sap/m/ColumnListItem",                                                                                                                                                                                                                                    
    "sap/m/StandardListItem",                                                                                                                                                                                                                                  
    "sap/m/FeedListItem",                                                                                                                                                                                                                                      
    "sap/m/Text",                                                                                                                                                                                                                                              
    "sap/m/ObjectNumber",                                                                                                                                                                                                                                      
    "sap/m/MessageToast",                                                                                                                                                                                                                                      
    "sap/m/MessageBox",                                                                                                                                                                                                                                        
    "sap/m/CustomListItem",                                                                                                                                                                                                                                    
    "sap/m/HBox",                                                                                                                                                                                                                                              
    "sap/m/VBox",                                                                                                                                                                                                                                              
    "sap/ui/core/Icon",                                                                                                                                                                                                                                        
    "sap/ui/core/HTML",                                                                                                                                                                                                                                        
    "c1/mm/c1mmqr/util/CameraScanner",                                                                                                                                                                                                                         
  ],                                                                                                                                                                                                                                                           
  function (                                                                                                                                                                                                                                                   
    Controller,                                                                                                                                                                                                                                                
    Filter,                                                                                                                                                                                                                                                    
    FilterOperator,                                                                                                                                                                                                                                            
    ColumnListItem,                                                                                                                                                                                                                                            
    StandardListItem,                                                                                                                                                                                                                                          
    FeedListItem,                                                                                                                                                                                                                                              
    Text,                                                                                                                                                                                                                                                      
    ObjectNumber,                                                                                                                                                                                                                                              
    MessageToast,                                                                                                                                                                                                                                              
    MessageBox,                                                                                                                                                                                                                                                
    CustomListItem,                                                                                                                                                                                                                                            
    HBox,                                                                                                                                                                                                                                                      
    VBox,                                                                                                                                                                                                                                                      
    CoreIcon,                                                                                                                                                                                                                                                  
    CoreHTML,                                                                                                                                                                                                                                                  
    CameraScanner,                                                                                                                                                                                                                                             
  ) {                                                                                                                                                                                                                                                          
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    return Controller.extend("c1.mm.c1mmqr.controller.qrScanView", {                                                                                                                                                                                           
      // 저장위치 코드 → 한글명                                                                                                                                                                                                                                         
      LGORT_NAMES: {                                                                                                                                                                                                                                           
        SL10: "원자재창고",                                                                                                                                                                                                                                         
        SL20: "반제품창고",                                                                                                                                                                                                                                         
        SL30: "완제품창고",                                                                                                                                                                                                                                         
        SL40: "품질검사창고",                                                                                                                                                                                                                                        
        SL50: "보류/반품창고",                                                                                                                                                                                                                                       
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      _lgortName: function (s) {                                                                                                                                                                                                                               
        return this.LGORT_NAMES[(s || "").trim()] || s || "-";                                                                                                                                                                                                 
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      // 자재 이미지: webapp/images/<자재번호>.png                                                                                                                                                                                                                      
      _imgUrl: function (sMatnr) {                                                                                                                                                                                                                             
        return (                                                                                                                                                                                                                                               
          sap.ui.require.toUrl("c1/mm/c1mmqr/images") +                                                                                                                                                                                                        
          "/" +                                                                                                                                                                                                                                                
          encodeURIComponent(sMatnr) +                                                                                                                                                                                                                         
          ".png"                                                                                                                                                                                                                                               
        );                                                                                                                                                                                                                                                     
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      onInit: function () {                                                                                                                                                                                                                                    
        var oRouter = this.getOwnerComponent().getRouter();                                                                                                                                                                                                    
        oRouter                                                                                                                                                                                                                                                
          .getRoute("RouteqrScan")                                                                                                                                                                                                                             
          .attachPatternMatched(this._onRoute, this);                                                                                                                                                                                                          
        oRouter                                                                                                                                                                                                                                                
          .getRoute("RouteqrScanDirect")                                                                                                                                                                                                                       
          .attachPatternMatched(this._onRouteDirect, this);                                                                                                                                                                                                    
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      _onRoute: function () {                                                                                                                                                                                                                                  
        this._clearResult();                                                                                                                                                                                                                                   
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      // QR 링크(#/scan/QR번호)로 직접 진입 시 자동 조회                                                                                                                                                                                                                     
      _onRouteDirect: function (oEvent) {                                                                                                                                                                                                                      
        var sQrNo = oEvent.getParameter("arguments").qrNo;                                                                                                                                                                                                     
        this._clearResult();                                                                                                                                                                                                                                   
        if (sQrNo) {                                                                                                                                                                                                                                           
          this._searchByQrNo(decodeURIComponent(sQrNo));                                                                                                                                                                                                       
        }                                                                                                                                                                                                                                                      
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      onNavBack: function () {                                                                                                                                                                                                                                 
        this.getOwnerComponent().getRouter().navTo("RouteqrView");                                                                                                                                                                                             
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      // ── 카메라 스캔 ────────────────────────────────────────                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
      onStartScan: function () {                                                                                                                                                                                                                               
        CameraScanner.scan(                                                                                                                                                                                                                                    
          function (sRaw) {                                                                                                                                                                                                                                    
            var sText = (sRaw || "").trim();                                                                                                                                                                                                                   
            // QR에 URL이 들어있으면 QR번호만 추출                                                                                                                                                                                                                         
            var aMatch = sText.match(/#\/scan\/(.+)$/);                                                                                                                                                                                                        
            if (aMatch) sText = decodeURIComponent(aMatch[1]);                                                                                                                                                                                                 
            this._searchByQrNo(sText);                                                                                                                                                                                                                         
          }.bind(this),                                                                                                                                                                                                                                        
        );                                                                                                                                                                                                                                                     
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      // ── 수동 입력 조회 ─────────────────────────────────────                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
      onManualSearch: function () {                                                                                                                                                                                                                            
        var sQrNo = this.byId("inManualQr").getValue().trim();                                                                                                                                                                                                 
        if (!sQrNo) {                                                                                                                                                                                                                                          
          MessageToast.show("QR번호를 입력하세요.");                                                                                                                                                                                                                   
          return;                                                                                                                                                                                                                                              
        }                                                                                                                                                                                                                                                      
        this._searchByQrNo(sQrNo);                                                                                                                                                                                                                             
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      // ── QR번호로 이력 조회 ─────────────────────────────────                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
      _searchByQrNo: function (sQrNo) {                                                                                                                                                                                                                        
        var oModel = this.getOwnerComponent().getModel();                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        oModel.read("/QrHist('" + encodeURIComponent(sQrNo) + "')", {                                                                                                                                                                                          
          success: function (oData) {                                                                                                                                                                                                                          
            this._showResult(oData);                                                                                                                                                                                                                           
            this._loadBatchStock(oData);                                                                                                                                                                                                                       
            this._loadBatchHist(oData);                                                                                                                                                                                                                        
            this._recordScanHistory(sQrNo);                                                                                                                                                                                                                    
          }.bind(this),                                                                                                                                                                                                                                        
          error: function () {                                                                                                                                                                                                                                 
            MessageBox.error(                                                                                                                                                                                                                                  
              "QR번호 [" + sQrNo + "] 에 해당하는 정보를 찾을 수 없습니다.",                                                                                                                                                                                                    
            );                                                                                                                                                                                                                                                 
            this._clearResult();                                                                                                                                                                                                                               
          }.bind(this),                                                                                                                                                                                                                                        
        });                                                                                                                                                                                                                                                    
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      // ── 결과 표시 ──────────────────────────────────────────                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
      _showResult: function (oData) {                                                                                                                                                                                                                          
        this.byId("scanResultBox").setVisible(true);                                                                                                                                                                                                           
        var oEmpty = this.byId("scanEmpty");                                                                                                                                                                                                                   
        if (oEmpty) { oEmpty.setVisible(false); }                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
        this.byId("rMatnr").setText(oData.Matnr || "");                                                                                                                                                                                                        
        this.byId("rMaktx").setText(oData.Maktx || "");                                                                                                                                                                                                        
        this.byId("rStatusBadge").setContent(this._fmtQrBadge(oData.QrStatus));                                                                                                                                                                                
        // 배치가 여러 창고에 분산될 수 있어 단일 저장위치 표기는 오해 소지 → 표시 안 함                                                                                                                                                                                                      
        this.byId("rLgort").setVisible(false);                                                                                                                                                                                                                 
        this.byId("rMenge").setText(                                                                                                                                                                                                                           
          "입고수량 " + this._fmtQty(oData.GrQty) + " " + (oData.Meins || ""),                                                                                                                                                                                     
        );                                                                                                                                                                                                                                                     
        this.byId("rQrNo").setText(oData.QrNo || "");                                                                                                                                                                                                          
        this.byId("rEbeln").setText(oData.Ebeln || "");                                                                                                                                                                                                        
        this.byId("rMblnr").setText(oData.Mblnr || "");                                                                                                                                                                                                        
        this.byId("rCharg").setText(oData.Charg || "");                                                                                                                                                                                                        
        this.byId("rVenName").setText(oData.VenName || "");                                                                                                                                                                                                    
        // 입고일: 문서생성일(Bldat) 우선, 없으면 전기일(GrDate)                                                                                                                                                                                                               
        this.byId("rGrDate").setText(                                                                                                                                                                                                                          
          this._fmtDate(oData.Bldat || oData.GrDate),                                                                                                                                                                                                          
        );                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // 자재 이미지 (실제 로드되는 URL만 골라 적용)                                                                                                                                                                                                                         
        this._setScanImg(oData.Matnr || "", oData.Maktx || "");                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
        this._oCurrentData = oData;                                                                                                                                                                                                                            
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      // "창고 현황에서 보기" → 부모(qrView)에 이벤트 전달 → 창고 현황 탭 + 자재 조회                                                                                                                                                                                                   
      onViewMaterialStock: function () {                                                                                                                                                                                                                       
        var sMatnr = (this._oCurrentData && this._oCurrentData.Matnr) || "";                                                                                                                                                                                   
        if (!sMatnr) { return; }                                                                                                                                                                                                                               
        this.getOwnerComponent().getEventBus().publish("qr", "viewMaterial", { matnr: sMatnr });                                                                                                                                                               
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      _hyphenMatnr: function (s) {                                                                                                                                                                                                                             
        var m = /^([A-Z]{2})([A-Z]{3})(\d+)$/.exec((s || "").toUpperCase());                                                                                                                                                                                   
        return m ? (m[1] + "-" + m[2] + "-" + m[3]) : s;                                                                                                                                                                                                       
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      _setScanImg: function (sMatnr, sMaktx) {                                                                                                                                                                                                                 
        var oImg = this.byId("rMatImg");                                                                                                                                                                                                                       
        var oFb = this.byId("rMatImgFallback");                                                                                                                                                                                                                
        var aCands = [];                                                                                                                                                                                                                                       
        if (sMatnr) {                                                                                                                                                                                                                                          
          aCands.push(this._imgUrl(sMatnr));                                                                                                                                                                                                                   
          var sHy = this._hyphenMatnr(sMatnr);                                                                                                                                                                                                                 
          if (sHy !== sMatnr) { aCands.push(this._imgUrl(sHy)); }                                                                                                                                                                                              
        }                                                                                                                                                                                                                                                      
        if (sMaktx) { aCands.push(this._imgUrl(sMaktx)); }                                                                                                                                                                                                     
        aCands.push(this._imgUrl("NO-IMAGE"));                                                                                                                                                                                                                 
        (function tryNext(i) {                                                                                                                                                                                                                                 
          if (i >= aCands.length) { oImg.setVisible(false); oFb.setVisible(true); return; }                                                                                                                                                                    
          var im = new window.Image();                                                                                                                                                                                                                         
          im.onload = function () { oImg.setSrc(aCands[i]); oImg.setVisible(true); oFb.setVisible(false); };                                                                                                                                                   
          im.onerror = function () { tryNext(i + 1); };                                                                                                                                                                                                        
          im.src = aCands[i];                                                                                                                                                                                                                                  
        })(0);                                                                                                                                                                                                                                                 
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      onScanImgError: function () {                                                                                                                                                                                                                            
        if (this._iImgTry === 1 && this._sImgMaktx) {                                                                                                                                                                                                          
          this._iImgTry = 2;                                                                                                                                                                                                                                   
          this.byId("rMatImg").setSrc(this._imgUrl(this._sImgMaktx));                                                                                                                                                                                          
          return;                                                                                                                                                                                                                                              
        }                                                                                                                                                                                                                                                      
        if (this._iImgTry <= 2) {                                                                                                                                                                                                                              
          this._iImgTry = 3;                                                                                                                                                                                                                                   
          this.byId("rMatImg").setSrc(this._imgUrl("NO-IMAGE"));                                                                                                                                                                                               
          return;                                                                                                                                                                                                                                              
        }                                                                                                                                                                                                                                                      
        this.byId("rMatImg").setVisible(false);                                                                                                                                                                                                                
        this.byId("rMatImgFallback").setVisible(true);                                                                                                                                                                                                         
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      _clearResult: function () {                                                                                                                                                                                                                              
        this._oCurrentData = null;                                                                                                                                                                                                                             
        this.byId("scanResultBox").setVisible(false);                                                                                                                                                                                                          
        var oEmpty = this.byId("scanEmpty");                                                                                                                                                                                                                   
        if (oEmpty) { oEmpty.setVisible(true); }                                                                                                                                                                                                               
        this.byId("inManualQr").setValue("");                                                                                                                                                                                                                  
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      onClearResult: function () {                                                                                                                                                                                                                             
        this._clearResult();                                                                                                                                                                                                                                   
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      // ── 현재고 조회 ────────────────────────────────────────                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
      _loadBatchStock: function (oData) {                                                                                                                                                                                                                      
        this._nBatchCurrent = null; // 새 조회 — 이전 값 무효화                                                                                                                                                                                                         
        var oTable = this.byId("rStockTable");                                                                                                                                                                                                                 
        oTable.destroyItems(); // 새 스캔마다 무조건 이전 표 비우기 (early return 전에)                                                                                                                                                                                        
        if (!oData.Matnr) return;                                                                                                                                                                                                                              
        var sWerks = oData.Werks || "TS00"; // 미전기 배치 등 Werks 비면 기본 플랜트                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
        var oModel = this.getOwnerComponent().getModel();                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        // 스캔 = 이 배치 중심 → 그 배치(Charg)만 저장위치별로                                                                                                                                                                                                                  
        var aFilters = [                                                                                                                                                                                                                                       
          new Filter("Matnr", FilterOperator.EQ, oData.Matnr),                                                                                                                                                                                                 
          new Filter("Werks", FilterOperator.EQ, sWerks),                                                                                                                                                                                                      
        ];                                                                                                                                                                                                                                                     
        if (oData.Charg) {                                                                                                                                                                                                                                     
          aFilters.push(new Filter("Charg", FilterOperator.EQ, oData.Charg));                                                                                                                                                                                  
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        oModel.read("/BatchStock", {                                                                                                                                                                                                                           
          filters: aFilters,                                                                                                                                                                                                                                   
          success: function (oResult) {                                                                                                                                                                                                                        
            oTable.destroyItems();                                                                                                                                                                                                                             
            var aRows = oResult.results || [];                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            // 저장위치(Lgort)별로 합산 (여러 배치 합치기)                                                                                                                                                                                                                    
            var mLgort = {};                                                                                                                                                                                                                                   
            aRows.forEach(function (oRow) {                                                                                                                                                                                                                    
              var k = oRow.Lgort || "";                                                                                                                                                                                                                        
              if (!mLgort[k]) {                                                                                                                                                                                                                                
                mLgort[k] = {                                                                                                                                                                                                                                  
                  Lgort: k,                                                                                                                                                                                                                                    
                  Clabs: 0,                                                                                                                                                                                                                                    
                  Cinsm: 0,                                                                                                                                                                                                                                    
                  Cspem: 0,                                                                                                                                                                                                                                    
                  Umlme: 0,                                                                                                                                                                                                                                    
                  Meins: oRow.Meins,                                                                                                                                                                                                                           
                };                                                                                                                                                                                                                                             
              }                                                                                                                                                                                                                                                
              mLgort[k].Clabs += parseFloat(oRow.Clabs || 0);                                                                                                                                                                                                  
              mLgort[k].Cinsm += parseFloat(oRow.Cinsm || 0);                                                                                                                                                                                                  
              mLgort[k].Cspem += parseFloat(oRow.Cspem || 0);                                                                                                                                                                                                  
              mLgort[k].Umlme += parseFloat(oRow.Umlme || 0);                                                                                                                                                                                                  
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            var nCurAll = 0, sMeins = "";                                                                                                                                                                                                                      
            Object.keys(mLgort)                                                                                                                                                                                                                                
              .sort()                                                                                                                                                                                                                                          
              .forEach(                                                                                                                                                                                                                                        
                function (k) {                                                                                                                                                                                                                                 
                  var o = mLgort[k];                                                                                                                                                                                                                           
                  nCurAll += o.Clabs + o.Cinsm + o.Cspem + o.Umlme;                                                                                                                                                                                            
                  sMeins = o.Meins || sMeins;                                                                                                                                                                                                                  
                  oTable.addItem(this._buildStockRow(o, oData.Lgort));                                                                                                                                                                                         
                }.bind(this),                                                                                                                                                                                                                                  
              );                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
            // 요약의 '현재'는 BatchStock 실제 합계 사용 (이동 차감 누락 방지)                                                                                                                                                                                                     
            this._nBatchCurrent = nCurAll;                                                                                                                                                                                                                     
            this._sStockMeins = sMeins;                                                                                                                                                                                                                        
            this._updateMoveSummary();                                                                                                                                                                                                                         
          }.bind(this),                                                                                                                                                                                                                                        
          error: function () {                                                                                                                                                                                                                                 
            MessageToast.show("현재고 조회 실패");                                                                                                                                                                                                                    
          },                                                                                                                                                                                                                                                   
        });                                                                                                                                                                                                                                                    
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      // 상태별 현재고 행 생성 (Clabs/Cinsm/Cspem/Umlme)                                                                                                                                                                                                                
      _buildStockRow: function (oRow, sCurrentLgort) {                                                                                                                                                                                                         
        var nClabs = parseFloat(oRow.Clabs || 0);                                                                                                                                                                                                              
        var nCinsm = parseFloat(oRow.Cinsm || 0);                                                                                                                                                                                                              
        var nCspem = parseFloat(oRow.Cspem || 0);                                                                                                                                                                                                              
        var nUmlme = parseFloat(oRow.Umlme || 0);                                                                                                                                                                                                              
        var nTotal = nClabs + nCinsm + nCspem + nUmlme;                                                                                                                                                                                                        
        var bCurrent = oRow.Lgort === sCurrentLgort;                                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
        return new ColumnListItem({                                                                                                                                                                                                                            
          highlight: bCurrent ? "Success" : "None",                                                                                                                                                                                                            
          cells: [                                                                                                                                                                                                                                             
            new Text({ text: this._lgortName(oRow.Lgort), wrapping: false }),                                                                                                                                                                                  
            new ObjectNumber({                                                                                                                                                                                                                                 
              number: this._fmtQty(nTotal),                                                                                                                                                                                                                    
              emphasized: true,                                                                                                                                                                                                                                
            }),                                                                                                                                                                                                                                                
            new ObjectNumber({                                                                                                                                                                                                                                 
              number: this._fmtQty(nClabs),                                                                                                                                                                                                                    
              emphasized: true,                                                                                                                                                                                                                                
              state: nClabs > 0 ? "Success" : "None",                                                                                                                                                                                                          
            }),                                                                                                                                                                                                                                                
            new ObjectNumber({                                                                                                                                                                                                                                 
              number: this._fmtQty(nCinsm),                                                                                                                                                                                                                    
              emphasized: true,                                                                                                                                                                                                                                
              state: nCinsm > 0 ? "Warning" : "None",                                                                                                                                                                                                          
            }),                                                                                                                                                                                                                                                
            new ObjectNumber({                                                                                                                                                                                                                                 
              number: this._fmtQty(nCspem),                                                                                                                                                                                                                    
              emphasized: true,                                                                                                                                                                                                                                
              state: nCspem > 0 ? "Error" : "None",                                                                                                                                                                                                            
            }),                                                                                                                                                                                                                                                
            new Text({ text: oRow.Meins }),                                                                                                                                                                                                                    
          ],                                                                                                                                                                                                                                                   
        });                                                                                                                                                                                                                                                    
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      // 수량 포맷: 천단위 콤마, 불필요한 .000 제거                                                                                                                                                                                                                           
      _fmtQty: function (v) {                                                                                                                                                                                                                                  
        return Number(v || 0).toLocaleString("ko-KR", {                                                                                                                                                                                                        
          maximumFractionDigits: 3,                                                                                                                                                                                                                            
        });                                                                                                                                                                                                                                                    
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      // ── 이동 이력(역추적/정추적) 타임라인 ──────────────────                                                                                                                                                                                                             
      _loadBatchHist: function (oData) {                                                                                                                                                                                                                       
        var oList = this.byId("rMoveHistList");                                                                                                                                                                                                                
        oList.destroyItems();                                                                                                                                                                                                                                  
        if (!oData.Charg) return;                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
        var oModel = this.getOwnerComponent().getModel();                                                                                                                                                                                                      
        var aFilters = [new Filter("Charg", FilterOperator.EQ, oData.Charg)];                                                                                                                                                                                  
        if (oData.Matnr) {                                                                                                                                                                                                                                     
          aFilters.push(new Filter("Matnr", FilterOperator.EQ, oData.Matnr));                                                                                                                                                                                  
        }                                                                                                                                                                                                                                                      
        if (oData.Werks) {                                                                                                                                                                                                                                     
          aFilters.push(new Filter("Werks", FilterOperator.EQ, oData.Werks));                                                                                                                                                                                  
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        oModel.read("/BatchHist", {                                                                                                                                                                                                                            
          filters: aFilters,                                                                                                                                                                                                                                   
          sorters: [                                                                                                                                                                                                                                           
            new sap.ui.model.Sorter("Budat", true), // 최신순(내림차순)                                                                                                                                                                                               
            new sap.ui.model.Sorter("Mblnr", true),                                                                                                                                                                                                            
          ],                                                                                                                                                                                                                                                   
          success: function (oResult) {                                                                                                                                                                                                                        
            var aRows = oResult.results || [];                                                                                                                                                                                                                 
            this._aMoveRows = aRows;                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
            var nIn = 0, nOut = 0, sMeins = "";                                                                                                                                                                                                                
            aRows.forEach(function (oRow) {                                                                                                                                                                                                                    
              var oKind = this._moveKind(oRow.Bwart);                                                                                                                                                                                                          
              var nQty = parseFloat(oRow.Menge || 0);                                                                                                                                                                                                          
              if (oKind.txt === "입고") nIn += nQty;                                                                                                                                                                                                             
              else if (oKind.txt === "출고") nOut += nQty;                                                                                                                                                                                                       
              sMeins = oRow.Meins || sMeins;                                                                                                                                                                                                                   
            }, this);                                                                                                                                                                                                                                          
            this._nMoveIn = nIn;                                                                                                                                                                                                                               
            this._nMoveOut = nOut;                                                                                                                                                                                                                             
            this._sMoveMeins = sMeins;                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
            // 히어로 수량 = 이 배치 누적 입고                                                                                                                                                                                                                             
            this.byId("rMenge").setText("누적 입고 " + this._fmtQty(nIn) + " " + sMeins);                                                                                                                                                                          
                                                                                                                                                                                                                                                               
            // 상단 요약 갱신 (현재고는 BatchStock 합계 우선)                                                                                                                                                                                                                
            this._updateMoveSummary();                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
            // 필터 칩 기본값(전체)으로 렌더                                                                                                                                                                                                                               
            var oSeg = this.byId("segMoveFilter");                                                                                                                                                                                                             
            if (oSeg) oSeg.setSelectedKey("ALL");                                                                                                                                                                                                              
            this._renderMoveList("ALL");                                                                                                                                                                                                                       
          }.bind(this),                                                                                                                                                                                                                                        
          error: function () {                                                                                                                                                                                                                                 
            MessageToast.show("이동 이력 조회 실패");                                                                                                                                                                                                                  
          },                                                                                                                                                                                                                                                   
        });                                                                                                                                                                                                                                                    
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      // 유형 필터(전체/입고/출고/이동)에 맞춰 행 렌더                                                                                                                                                                                                                           
      _renderMoveList: function (sKind) {                                                                                                                                                                                                                      
        var oList = this.byId("rMoveHistList");                                                                                                                                                                                                                
        oList.destroyItems();                                                                                                                                                                                                                                  
        (this._aMoveRows || []).forEach(function (oRow) {                                                                                                                                                                                                      
          if (sKind && sKind !== "ALL" && this._moveKind(oRow.Bwart).txt !== sKind) {                                                                                                                                                                          
            return;                                                                                                                                                                                                                                            
          }                                                                                                                                                                                                                                                    
          oList.addItem(this._buildMoveRow(oRow));                                                                                                                                                                                                             
        }, this);                                                                                                                                                                                                                                              
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      onMoveFilter: function (oEvent) {                                                                                                                                                                                                                        
        var oItem = oEvent.getParameter("item");                                                                                                                                                                                                               
        this._renderMoveList(oItem ? oItem.getKey() : "ALL");                                                                                                                                                                                                  
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      // 요약 갱신: 현재고는 BatchStock 실제 합계 우선, 없으면 입고−출고                                                                                                                                                                                                            
      _updateMoveSummary: function () {                                                                                                                                                                                                                        
        var oSum = this.byId("rMoveSummary");                                                                                                                                                                                                                  
        if (!oSum) return;                                                                                                                                                                                                                                     
        var nIn = this._nMoveIn || 0;                                                                                                                                                                                                                          
        var nOut = this._nMoveOut || 0;                                                                                                                                                                                                                        
        var sMeins = this._sStockMeins || this._sMoveMeins || "";                                                                                                                                                                                              
        var sCur =                                                                                                                                                                                                                                             
          this._nBatchCurrent != null                                                                                                                                                                                                                          
            ? this._fmtQty(this._nBatchCurrent)                                                                                                                                                                                                                
            : this._fmtQty(nIn - nOut);                                                                                                                                                                                                                        
        oSum.setText(                                                                                                                                                                                                                                          
          "누적 입고 " + this._fmtQty(nIn) +                                                                                                                                                                                                                       
          " · 출고 " + this._fmtQty(nOut) +                                                                                                                                                                                                                      
          " · 현재 " + sCur + " " + sMeins,                                                                                                                                                                                                                      
        );                                                                                                                                                                                                                                                     
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      // 이동유형(BWART) → 구분/아이콘/부호                                                                                                                                                                                                                               
      _moveKind: function (sBwart) {                                                                                                                                                                                                                           
        var s = (sBwart || "").trim();                                                                                                                                                                                                                         
        // 입고 계열 (101=구매입고, 131=생산입고)                                                                                                                                                                                                                          
        if (s === "101" || s === "131" || s === "501" || s === "561") {                                                                                                                                                                                        
          return { txt: "입고", icon: "sap-icon://cart", sign: "+" };                                                                                                                                                                                            
        }                                                                                                                                                                                                                                                      
        // 출고/소비 계열                                                                                                                                                                                                                                            
        if (                                                                                                                                                                                                                                                   
          s === "201" ||                                                                                                                                                                                                                                       
          s === "261" ||                                                                                                                                                                                                                                       
          s === "601" ||                                                                                                                                                                                                                                       
          s === "551" ||                                                                                                                                                                                                                                       
          s === "102"                                                                                                                                                                                                                                          
        ) {                                                                                                                                                                                                                                                    
          return { txt: "출고", icon: "sap-icon://shipping-status", sign: "-" };                                                                                                                                                                                 
        }                                                                                                                                                                                                                                                      
        // 이동전기(창고/상태 간)                                                                                                                                                                                                                                       
        return { txt: "이동", icon: "sap-icon://move", sign: "" };                                                                                                                                                                                               
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      // 행 아이콘: 이동은 '창고→창고' 커스텀 SVG, 그 외는 SAP 아이콘                                                                                                                                                                                                              
      _buildMoveIcon: function (oKind) {                                                                                                                                                                                                                       
        if (oKind.txt === "이동") {                                                                                                                                                                                                                              
          var sSvg =                                                                                                                                                                                                                                           
            "<div class='qrMoveIcon qrMoveIconSvg'>" +                                                                                                                                                                                                         
            "<svg width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='#0a6ed1' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>" +                                                                                                
            "<path d='M3 11 L12 5 L21 11'/><path d='M5 11 V19 H19 V11'/>" +                                                                                                                                                                                    
            "<path d='M8 15 h8 m0 0 l-2.3 -2.3 m2.3 2.3 l-2.3 2.3'/>" +                                                                                                                                                                                        
            "</svg></div>";                                                                                                                                                                                                                                    
          return new CoreHTML({ content: sSvg });                                                                                                                                                                                                              
        }                                                                                                                                                                                                                                                      
        return new CoreIcon({ src: oKind.icon, size: "1.3rem" }).addStyleClass(                                                                                                                                                                                
          "qrMoveIcon",                                                                                                                                                                                                                                        
        );                                                                                                                                                                                                                                                     
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      _buildMoveRow: function (oRow) {                                                                                                                                                                                                                         
        var oKind = this._moveKind(oRow.Bwart);                                                                                                                                                                                                                
        var sQty =                                                                                                                                                                                                                                             
          oKind.sign + this._fmtQty(oRow.Menge) + " " + (oRow.Meins || "");                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
        // 공급업체: 이름 우선 (이력행에 VenName 있으면 사용, 없으면 스캔건과 같은 업체일 때 그 이름, 최후엔 번호)                                                                                                                                                                                   
        var sVen = oRow.VenName;                                                                                                                                                                                                                               
        if (!sVen && this._oCurrentData &&                                                                                                                                                                                                                     
            oRow.Lifnr && oRow.Lifnr === this._oCurrentData.Lifnr) {                                                                                                                                                                                           
          sVen = this._oCurrentData.VenName;                                                                                                                                                                                                                   
        }                                                                                                                                                                                                                                                      
        if (!sVen && oRow.Lifnr) sVen = oRow.Lifnr;                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
        // 상세: 입고=PO/공급업체, 이동=From→To, 출고=생산오더/위치 (저장위치는 한글명)                                                                                                                                                                                                  
        var sSub;                                                                                                                                                                                                                                              
        if (oKind.txt === "입고") {                                                                                                                                                                                                                              
          if (oRow.Ebeln) {                                                                                                                                                                                                                                    
            // 구매입고(101): PO/공급업체                                                                                                                                                                                                                              
            sSub =                                                                                                                                                                                                                                             
              "구매오더 " +                                                                                                                                                                                                                                        
              oRow.Ebeln +                                                                                                                                                                                                                                     
              (sVen ? " · " + sVen : "") +                                                                                                                                                                                                                     
              " · " +                                                                                                                                                                                                                                          
              this._lgortName(oRow.Lgort);                                                                                                                                                                                                                     
          } else if (oRow.Aufnr && oRow.Aufnr !== "0000000000") {                                                                                                                                                                                              
            // 생산입고(131): 생산오더                                                                                                                                                                                                                                 
            sSub = "생산오더 " + oRow.Aufnr + " · " + this._lgortName(oRow.Lgort);                                                                                                                                                                                 
          } else {                                                                                                                                                                                                                                             
            sSub = this._lgortName(oRow.Lgort);                                                                                                                                                                                                                
          }                                                                                                                                                                                                                                                    
        } else if (oKind.txt === "출고") {                                                                                                                                                                                                                       
          sSub =                                                                                                                                                                                                                                               
            (oRow.Aufnr && oRow.Aufnr !== "0000000000"                                                                                                                                                                                                         
              ? "생산오더 " + oRow.Aufnr + " · "                                                                                                                                                                                                                   
              : "") + this._lgortName(oRow.Lgort);                                                                                                                                                                                                             
        } else {                                                                                                                                                                                                                                               
          sSub =                                                                                                                                                                                                                                               
            this._lgortName(oRow.Lgort) + " → " +                                                                                                                                                                                                              
            this._lgortName(oRow.Umlgo || oRow.Lgort);                                                                                                                                                                                                         
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        return new CustomListItem({                                                                                                                                                                                                                            
          content: [                                                                                                                                                                                                                                           
            new HBox({                                                                                                                                                                                                                                         
              alignItems: "Center",                                                                                                                                                                                                                            
              width: "100%",                                                                                                                                                                                                                                   
              items: [                                                                                                                                                                                                                                         
                this._buildMoveIcon(oKind),                                                                                                                                                                                                                    
                new VBox({                                                                                                                                                                                                                                     
                  width: "100%",                                                                                                                                                                                                                               
                  items: [                                                                                                                                                                                                                                     
                    new Text({ text: oKind.txt + " " + sQty }).addStyleClass("qrMoveTitle"),                                                                                                                                                                   
                    new Text({ text: sSub }).addStyleClass("qrMoveSub"),                                                                                                                                                                                       
                    new Text({ text: this._fmtDate(oRow.Budat || oRow.Bldat) }).addStyleClass("qrMoveDate"),                                                                                                                                                   
                  ],                                                                                                                                                                                                                                           
                }).addStyleClass("qrMoveBody"),                                                                                                                                                                                                                
              ],                                                                                                                                                                                                                                               
            }).addStyleClass("qrMoveRow"),                                                                                                                                                                                                                     
          ],                                                                                                                                                                                                                                                   
        }).addStyleClass("qrMoveItem qrMoveItem--" + oKind.txt);                                                                                                                                                                                               
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      // ── 스캔 이력 기록/표시 ────────────────────────────────                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      _recordScanHistory: function (sQrNo) {                                                                                                                                                                                                                   
        var oList = this.byId("rScanHistList");                                                                                                                                                                                                                
        var sTime = new Date().toLocaleString("ko-KR");                                                                                                                                                                                                        
        oList.insertItem(                                                                                                                                                                                                                                      
          new StandardListItem({                                                                                                                                                                                                                               
            title: sQrNo,                                                                                                                                                                                                                                      
            description: sTime,                                                                                                                                                                                                                                
            icon: "sap-icon://bar-code",                                                                                                                                                                                                                       
          }),                                                                                                                                                                                                                                                  
          0,                                                                                                                                                                                                                                                   
        );                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        var aItems = oList.getItems();                                                                                                                                                                                                                         
        if (aItems.length > 20) {                                                                                                                                                                                                                              
          oList.removeItem(aItems[aItems.length - 1]);                                                                                                                                                                                                         
        }                                                                                                                                                                                                                                                      
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      // ── 포맷터 ─────────────────────────────────────────────                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
      _fmtDate: function (oDate) {                                                                                                                                                                                                                             
        if (!oDate) return "-";                                                                                                                                                                                                                                
        var d = oDate instanceof Date ? oDate : new Date(oDate);                                                                                                                                                                                               
        if (isNaN(d.getTime())) return "-";                                                                                                                                                                                                                    
        return (                                                                                                                                                                                                                                               
          d.getFullYear() +                                                                                                                                                                                                                                    
          "-" +                                                                                                                                                                                                                                                
          String(d.getMonth() + 1).padStart(2, "0") +                                                                                                                                                                                                          
          "-" +                                                                                                                                                                                                                                                
          String(d.getDate()).padStart(2, "0")                                                                                                                                                                                                                 
        );                                                                                                                                                                                                                                                     
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      _fmtQrBadge: function (sStatus) {                                                                                                                                                                                                                        
        if (sStatus === "I") {                                                                                                                                                                                                                                 
          return "<span class='qrBadge qrBadge--issued'>발행완료</span>";                                                                                                                                                                                          
        }                                                                                                                                                                                                                                                      
        return "<span class='qrBadge qrBadge--new'>미발행</span>";                                                                                                                                                                                                
      },                                                                                                                                                                                                                                                       
    });                                                                                                                                                                                                                                                        
  },                                                                                                                                                                                                                                                           
);                                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               