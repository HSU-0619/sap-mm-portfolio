<core:FragmentDefinition                                                                                                                                                                                                                                       
    xmlns="sap.m"                                                                                                                                                                                                                                              
    xmlns:core="sap.ui.core">                                                                                                                                                                                                                                  
    <Dialog title="변경 상세 — 판매오더 {detail>/orderText}"                                                                                                                                                                                                           
        contentWidth="44rem"                                                                                                                                                                                                                                   
        contentHeight="auto"                                                                                                                                                                                                                                   
        horizontalScrolling="false"                                                                                                                                                                                                                            
        draggable="true"                                                                                                                                                                                                                                       
        resizable="true">                                                                                                                                                                                                                                      
        <content>                                                                                                                                                                                                                                              
            <!-- 문서 흐름 (판매오더 → 납품 → 청구) -->                                                                                                                                                                                                                    
            <VBox class="c1FlowBox">                                                                                                                                                                                                                           
                <HBox alignItems="Center" class="c1FlowHead">                                                                                                                                                                                                  
                    <core:Icon src="sap-icon://process" class="c1FlowIcon"/>                                                                                                                                                                                   
                    <Text text="문서 흐름" class="c1FlowTitle"/>                                                                                                                                                                                                   
                </HBox>                                                                                                                                                                                                                                        
                <Text text="{detail>/flowText}" class="c1FlowText"/>                                                                                                                                                                                           
            </VBox>                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
            <List items="{detail>/items}" showSeparators="Inner" width="100%" class="c1DetailList">                                                                                                                                                            
                <CustomListItem type="Inactive">                                                                                                                                                                                                               
                    <VBox class="c1DetailItem">                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
                        <!-- 변경 필드 -->                                                                                                                                                                                                                         
                        <HBox justifyContent="SpaceBetween" alignItems="Center" class="c1DetailHead">                                                                                                                                                          
                            <HBox alignItems="Center">                                                                                                                                                                                                         
                                <core:Icon src="{detail>levelIcon}" size="1rem" class="c1LineIcon"/>                                                                                                                                                           
                                <VBox>                                                                                                                                                                                                                         
                                    <Text text="{detail>fieldLabel}" class="c1FieldName"/>                                                                                                                                                                     
                                    <Text text="{detail>itemText}" class="c1FieldSub"/>                                                                                                                                                                        
                                </VBox>                                                                                                                                                                                                                        
                            </HBox>                                                                                                                                                                                                                            
                            <HBox alignItems="Center">                                                                                                                                                                                                         
                                <Text text="{detail>valueOld}" class="c1ValOld"/>                                                                                                                                                                              
                                <core:Icon src="sap-icon://arrow-right" size="0.85rem" class="c1Arrow"/>                                                                                                                                                       
                                <ObjectStatus text="{detail>valueNew}" state="{detail>changeState}" class="c1ValNew"/>                                                                                                                                         
                            </HBox>                                                                                                                                                                                                                            
                        </HBox>                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
                        <!-- 납기 영향 (ATP) -->                                                                                                                                                                                                                   
                        <VBox visible="{detail>hasAtp}" class="c1AtpBox">                                                                                                                                                                                      
                            <Text text="자재 {detail>matnr} · 플랜트 {detail>plant}" class="c1AtpMatnr"/>                                                                                                                                                           
                            <HBox class="c1AtpRow" wrap="Wrap">                                                                                                                                                                                                
                                <VBox class="c1AtpCell">                                                                                                                                                                                                       
                                    <Text text="필요수량" class="c1AtpLabel"/>                                                                                                                                                                                     
                                    <Text text="{detail>requiredText}" class="c1AtpVal"/>                                                                                                                                                                      
                                </VBox>                                                                                                                                                                                                                        
                                <VBox class="c1AtpCell">                                                                                                                                                                                                       
                                    <Text text="현재고" class="c1AtpLabel"/>                                                                                                                                                                                      
                                    <Text text="{detail>availableText}" class="c1AtpVal"/>                                                                                                                                                                     
                                </VBox>                                                                                                                                                                                                                        
                                <VBox class="c1AtpCell" visible="{detail>showStockShort}">                                                                                                                                                                     
                                    <Text text="재고 부족" class="c1AtpLabel"/>                                                                                                                                                                                    
                                    <Text text="{detail>stockShortText}" class="c1AtpVal c1AtpNeg"/>                                                                                                                                                           
                                </VBox>                                                                                                                                                                                                                        
                                <VBox class="c1AtpCell" visible="{detail>showIncoming}">                                                                                                                                                                       
                                    <Text text="입고예정" class="c1AtpLabel"/>                                                                                                                                                                                     
                                    <Text text="{detail>incomingText}" class="c1AtpVal c1AtpPos"/>                                                                                                                                                             
                                </VBox>                                                                                                                                                                                                                        
                                <VBox class="c1AtpCell">                                                                                                                                                                                                       
                                    <Text text="최단 출고가능일" class="c1AtpLabel"/>                                                                                                                                                                                 
                                    <Text text="{detail>shipDateText}" class="c1AtpVal"/>                                                                                                                                                                      
                                </VBox>                                                                                                                                                                                                                        
                            </HBox>                                                                                                                                                                                                                            
                            <ObjectStatus text="{detail>statusText}" state="{detail>statusState}"                                                                                                                                                              
                                icon="{detail>statusIcon}" class="c1AtpStatus"/>                                                                                                                                                                               
                        </VBox>                                                                                                                                                                                                                                
                    </VBox>                                                                                                                                                                                                                                    
                </CustomListItem>                                                                                                                                                                                                                              
            </List>                                                                                                                                                                                                                                            
        </content>                                                                                                                                                                                                                                             
        <beginButton>                                                                                                                                                                                                                                          
            <Button text="닫기" type="Emphasized" press=".onCloseDetail"/>                                                                                                                                                                                       
        </beginButton>                                                                                                                                                                                                                                         
    </Dialog>                                                                                                                                                                                                                                                  
</core:FragmentDefinition>                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               