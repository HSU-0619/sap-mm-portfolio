sap.ui.define([                                                                                                                                                                                                                                                
    "sap/ui/core/mvc/Controller",                                                                                                                                                                                                                              
    "sap/ui/core/Fragment",                                                                                                                                                                                                                                    
    "sap/ui/model/json/JSONModel",                                                                                                                                                                                                                             
    "sap/ui/model/Filter",                                                                                                                                                                                                                                     
    "sap/ui/model/FilterOperator",                                                                                                                                                                                                                             
    "sap/ui/export/Spreadsheet",                                                                                                                                                                                                                               
    "sap/m/MessageToast",                                                                                                                                                                                                                                      
    "../model/formatter"                                                                                                                                                                                                                                       
], (Controller, Fragment, JSONModel, Filter, FilterOperator, Spreadsheet, MessageToast, formatter) => {                                                                                                                                                        
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    return Controller.extend("c1.sd.c1sdso.controller.soView", {                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
        formatter: formatter,                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
        onInit() {                                                                                                                                                                                                                                             
            this.getView().setModel(new JSONModel({                                                                                                                                                                                                            
                orderCount: 0, itemCount: 0, userCount: 0, latestDate: "-"                                                                                                                                                                                     
            }), "ui");                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
            this.getView().setModel(new JSONModel({                                                                                                                                                                                                            
                custTop: [], atpDist: [], amtDist: []                                                                                                                                                                                                          
            }), "analytics");                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            this.getView().setModel(new JSONModel({ orders: [], count: 0 }), "master");                                                                                                                                                                        
                                                                                                                                                                                                                                                               
            this.getView().setModel(new JSONModel({                                                                                                                                                                                                            
                users: [{ key: "", text: "전체" }], usersLoaded: false,                                                                                                                                                                                          
                selectedSO: null, selSoDisp: "-",                                                                                                                                                                                                              
                sumAmtFrom: "-", sumAmtTo: "-", sumAmtPct: "",                                                                                                                                                                                                 
                sumQtyFrom: "-", sumQtyTo: "-", sumQtyUom: "",                                                                                                                                                                                                 
                changeCnt: 0                                                                                                                                                                                                                                   
            }), "view");                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
            this._aFilters = [];                                                                                                                                                                                                                               
            this._soItems = {};                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            const oModel = this.getOwnerComponent().getModel();                                                                                                                                                                                                
            if (oModel && oModel.metadataLoaded) {                                                                                                                                                                                                             
                oModel.metadataLoaded().then(() => {                                                                                                                                                                                                           
                    this._loadMaster();                                                                                                                                                                                                                        
                    this._loadAnalytics();                                                                                                                                                                                                                     
                });                                                                                                                                                                                                                                            
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onSearch() {                                                                                                                                                                                                                                           
            this._aFilters = this._buildFilters();                                                                                                                                                                                                             
            this._loadMaster();                                                                                                                                                                                                                                
            this._loadAnalytics();                                                                                                                                                                                                                             
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onClearFilters() {                                                                                                                                                                                                                                     
            this.byId("soSearch").setValue("");                                                                                                                                                                                                                
            this.byId("userSelect").setSelectedKey("");                                                                                                                                                                                                        
            this.byId("fieldSelect").setSelectedKey("");                                                                                                                                                                                                       
            this.byId("dateFrom").setValue("");                                                                                                                                                                                                                
            this.byId("dateTo").setValue("");                                                                                                                                                                                                                  
            this._aFilters = [];                                                                                                                                                                                                                               
            this._loadMaster();                                                                                                                                                                                                                                
            this._loadAnalytics();                                                                                                                                                                                                                             
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // 각 필드 독립 — 하나만 입력해도 조회됨 (날짜도 한쪽만 OK)                                                                                                                                                                                                                 
        _buildFilters() {                                                                                                                                                                                                                                      
            const aFilters = [];                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
            const sSo = this.byId("soSearch").getValue().trim();                                                                                                                                                                                               
            if (sSo) { aFilters.push(new Filter("SalesOrder", FilterOperator.EQ, sSo.padStart(10, "0"))); }                                                                                                                                                    
                                                                                                                                                                                                                                                               
            const sUser = this.byId("userSelect").getSelectedKey();                                                                                                                                                                                            
            if (sUser) { aFilters.push(new Filter("ErNam", FilterOperator.EQ, sUser)); }                                                                                                                                                                       
                                                                                                                                                                                                                                                               
            const sField = this.byId("fieldSelect").getSelectedKey();                                                                                                                                                                                          
            if (sField) { aFilters.push(new Filter("FieldName", FilterOperator.EQ, sField)); }                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            const dFrom = this.byId("dateFrom").getDateValue();                                                                                                                                                                                                
            const dTo = this.byId("dateTo").getDateValue();                                                                                                                                                                                                    
            if (dFrom && dTo) { aFilters.push(new Filter("ErDat", FilterOperator.BT, dFrom, dTo)); }                                                                                                                                                           
            else if (dFrom) { aFilters.push(new Filter("ErDat", FilterOperator.GE, dFrom)); }                                                                                                                                                                  
            else if (dTo) { aFilters.push(new Filter("ErDat", FilterOperator.LE, dTo)); }                                                                                                                                                                      
                                                                                                                                                                                                                                                               
            return aFilters;                                                                                                                                                                                                                                   
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // ===== 마스터: 판매오더 목록 집계 =====                                                                                                                                                                                                                         
        _loadMaster() {                                                                                                                                                                                                                                        
            const oModel = this.getOwnerComponent().getModel();                                                                                                                                                                                                
            if (!oModel) { return; }                                                                                                                                                                                                                           
            oModel.read("/ChangeItem", {                                                                                                                                                                                                                       
                filters: this._aFilters,                                                                                                                                                                                                                       
                urlParameters: { "$top": 5000 },                                                                                                                                                                                                               
                success: (oData) => {                                                                                                                                                                                                                          
                    const aRows = oData.results || [];                                                                                                                                                                                                         
                    const mSO = {};                                                                                                                                                                                                                            
                    const mUsers = {};   // ErNam -> 이름                                                                                                                                                                                                        
                    let dLatest = null;                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
                    aRows.forEach((r) => {                                                                                                                                                                                                                     
                        if (!mSO[r.SalesOrder]) { mSO[r.SalesOrder] = []; }                                                                                                                                                                                    
                        mSO[r.SalesOrder].push(r);                                                                                                                                                                                                             
                        if (r.ErNam) { mUsers[r.ErNam] = r.ChangeUserName || r.ErNam; }                                                                                                                                                                        
                        if (r.ErDat instanceof Date && (!dLatest || r.ErDat > dLatest)) { dLatest = r.ErDat; }                                                                                                                                                 
                    });                                                                                                                                                                                                                                        
                    this._soItems = mSO;                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
                    // 최근 변경된 오더가 맨 위로 (변경일 내림차순, 동일 시 오더번호 내림차순)                                                                                                                                                                                              
                    const aOrders = Object.keys(mSO).map((so) => this._summarizeSO(so, mSO[so]))                                                                                                                                                               
                        .sort((a, b) => (b.dateTs - a.dateTs) || (b.so > a.so ? 1 : -1));                                                                                                                                                                      
                    const oMaster = this.getView().getModel("master");                                                                                                                                                                                         
                    oMaster.setProperty("/orders", aOrders);                                                                                                                                                                                                   
                    oMaster.setProperty("/count", aOrders.length);                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
                    const oUi = this.getView().getModel("ui");                                                                                                                                                                                                 
                    oUi.setProperty("/orderCount", aOrders.length);                                                                                                                                                                                            
                    // 금액(NETWR)은 수량 변경의 결과라 직접 변경 항목에서 제외                                                                                                                                                                                                     
                    oUi.setProperty("/itemCount", aRows.filter((r) => r.FieldName !== "NETWR").length);                                                                                                                                                        
                    oUi.setProperty("/userCount", Object.keys(mUsers).length);                                                                                                                                                                                 
                    oUi.setProperty("/latestDate", dLatest ? this._fmtDate(dLatest) : "-");                                                                                                                                                                    
                                                                                                                                                                                                                                                               
                    const oView = this.getView().getModel("view");                                                                                                                                                                                             
                    if (!oView.getProperty("/usersLoaded")) {                                                                                                                                                                                                  
                        const aU = [{ key: "", text: "전체" }].concat(                                                                                                                                                                                           
                            Object.keys(mUsers).sort().map((u) => ({ key: u, text: mUsers[u] })));                                                                                                                                                             
                        oView.setProperty("/users", aU);                                                                                                                                                                                                       
                        oView.setProperty("/usersLoaded", true);                                                                                                                                                                                               
                    }                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    // 첫 오더 자동 선택                                                                                                                                                                                                                              
                    if (aOrders.length) {                                                                                                                                                                                                                      
                        this._selectSO(aOrders[0].so);                                                                                                                                                                                                         
                        const oList = this.byId("masterList");                                                                                                                                                                                                 
                        const aItems = oList.getItems();                                                                                                                                                                                                       
                        if (aItems.length) { oList.setSelectedItem(aItems[0]); }                                                                                                                                                                               
                    } else {                                                                                                                                                                                                                                   
                        this._selectSO(null);                                                                                                                                                                                                                  
                    }                                                                                                                                                                                                                                          
                }                                                                                                                                                                                                                                              
            });                                                                                                                                                                                                                                                
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _summarizeSO(sSo, aItems) {                                                                                                                                                                                                                            
            const oAmt = this._netwrChange(aItems);                                                                                                                                                                                                            
            const aDates = aItems.map((i) => i.ErDat).filter((d) => d instanceof Date);                                                                                                                                                                        
            const dLatest = aDates.length ? new Date(Math.max.apply(null, aDates.map((d) => d.getTime()))) : null;                                                                                                                                             
                                                                                                                                                                                                                                                               
            // 3단계 임팩트 (금액 변동률 % 기준 — 오더 규모 무관)                                                                                                                                                                                                                
            const nPct = oAmt.pctNum || 0;                                                                                                                                                                                                                     
            let sImpact, sState;                                                                                                                                                                                                                               
            if (nPct >= 100) { sImpact = "High Impact"; sState = "Error"; }       // 2배 이상                                                                                                                                                                     
            else if (nPct >= 30) { sImpact = "Review"; sState = "Warning"; }       // 30% 이상                                                                                                                                                                   
            else { sImpact = "Normal"; sState = "Information"; }                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
            // 미니 차트 = 직접 변경 필드 건수 (수량 / 납기 — 실제 로깅되는 2개)                                                                                                                                                                                                      
            const cQty = aItems.filter((i) => i.FieldName === "KWMENG").length;                                                                                                                                                                                
            const cDlv = aItems.filter((i) => i.FieldName === "VDATU" || i.FieldName === "EDATU").length;                                                                                                                                                      
            const nMax = Math.max(1, cQty, cDlv);                                                                                                                                                                                                              
            const barH = (c) => (0.4 + (c / nMax) * 1.7).toFixed(2) + "rem";                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
            return {                                                                                                                                                                                                                                           
                so: sSo,                                                                                                                                                                                                                                       
                soDisp: formatter.soDisplay(sSo),                                                                                                                                                                                                              
                count: aItems.filter((i) => i.FieldName !== "NETWR").length,                                                                                                                                                                                   
                user: this._userName(aItems[aItems.length - 1]),                                                                                                                                                                                               
                date: dLatest ? this._fmtDate(dLatest) : "-",                                                                                                                                                                                                  
                dateTs: dLatest ? dLatest.getTime() : 0,   // 최근 변경 정렬용                                                                                                                                                                                        
                amtDiff: this._fmtAmt(oAmt.diff),                                                                                                                                                                                                              
                impact: sImpact,                                                                                                                                                                                                                               
                impactState: sState,                                                                                                                                                                                                                           
                barH1: barH(cQty), barT1: "수량 변경 " + cQty + "건",                                                                                                                                                                                               
                barH2: barH(cDlv), barT2: "납기 변경 " + cDlv + "건"                                                                                                                                                                                                
            };                                                                                                                                                                                                                                                 
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // 헤더 NETWR(오더 총액) 변경 추출                                                                                                                                                                                                                               
        _netwrChange(aItems) {                                                                                                                                                                                                                                 
            const a = aItems.filter((i) => i.FieldName === "NETWR" && i.TabName === "ZTC1SD0001")                                                                                                                                                              
                .sort((x, y) => ((x.ErDat && y.ErDat) ? (x.ErDat - y.ErDat) : 0));                                                                                                                                                                             
            if (!a.length) { return { from: "-", to: "-", diff: 0, pct: "", cuky: "" }; }                                                                                                                                                                      
            const oLast = a[a.length - 1];                                                                                                                                                                                                                     
            const o = parseFloat(String(a[0].ValueOld).replace(/,/g, ""));                                                                                                                                                                                     
            const n = parseFloat(String(oLast.ValueNew).replace(/,/g, ""));                                                                                                                                                                                    
            const diff = (!isNaN(o) && !isNaN(n)) ? (n - o) : 0;                                                                                                                                                                                               
            const pct = (!isNaN(o) && !isNaN(n) && o !== 0) ? (((n - o) / o) * 100).toFixed(1) + "%" : "";                                                                                                                                                     
            const nPctAbs = (!isNaN(o) && !isNaN(n) && o !== 0) ? Math.abs(((n - o) / o) * 100) : 0;                                                                                                                                                           
            return {                                                                                                                                                                                                                                           
                from: formatter.value(a[0].ValueOld),                                                                                                                                                                                                          
                to: formatter.value(oLast.ValueNew),                                                                                                                                                                                                           
                diff: diff,                                                                                                                                                                                                                                    
                pct: pct ? ((diff > 0 ? "+" : "") + pct) : "",                                                                                                                                                                                                 
                pctNum: nPctAbs,                                                                                                                                                                                                                               
                cuky: (oLast.CukyNew || oLast.CukyOld || "").trim()   // 통화키                                                                                                                                                                                   
            };                                                                                                                                                                                                                                                 
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // ===== 디테일: 선택 오더 상세 =====                                                                                                                                                                                                                           
        onMasterSelect(oEvent) {                                                                                                                                                                                                                               
            const oItem = oEvent.getParameter("listItem");                                                                                                                                                                                                     
            const oCtx = oItem && oItem.getBindingContext("master");                                                                                                                                                                                           
            if (oCtx) { this._selectSO(oCtx.getObject().so); }                                                                                                                                                                                                 
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _selectSO(sSo) {                                                                                                                                                                                                                                       
            const oView = this.getView().getModel("view");                                                                                                                                                                                                     
            oView.setProperty("/selectedSO", sSo);                                                                                                                                                                                                             
            oView.setProperty("/selSoDisp", sSo ? formatter.soDisplay(sSo) : "-");                                                                                                                                                                             
                                                                                                                                                                                                                                                               
            // 디테일 테이블 필터                                                                                                                                                                                                                                      
            const oBind = this.byId("changeList").getBinding("items");                                                                                                                                                                                         
            if (oBind) {                                                                                                                                                                                                                                       
                const aF = this._aFilters.slice();                                                                                                                                                                                                             
                aF.push(new Filter("SalesOrder", FilterOperator.EQ, sSo || "##none##"));                                                                                                                                                                       
                aF.push(new Filter("FieldName", FilterOperator.NE, "NETWR")); // 금액(결과) 제외                                                                                                                                                                     
                oBind.filter(aF);                                                                                                                                                                                                                              
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            const aItems = (sSo && this._soItems[sSo]) || [];                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // 총액 변경                                                                                                                                                                                                                                           
            const oAmt = this._netwrChange(aItems);                                                                                                                                                                                                            
            oView.setProperty("/sumAmtFrom", oAmt.from);                                                                                                                                                                                                       
            oView.setProperty("/sumAmtTo", oAmt.to);                                                                                                                                                                                                           
            oView.setProperty("/sumAmtCuky", oAmt.cuky);                                                                                                                                                                                                       
            oView.setProperty("/sumAmtPct", oAmt.pct);                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
            // 수량 변경                                                                                                                                                                                                                                           
            const aQ = aItems.filter((i) => i.FieldName === "KWMENG")                                                                                                                                                                                          
                .sort((x, y) => ((x.ErDat && y.ErDat) ? (x.ErDat - y.ErDat) : 0));                                                                                                                                                                             
            oView.setProperty("/sumQtyFrom", aQ.length ? formatter.value(aQ[0].ValueOld) : "-");                                                                                                                                                               
            oView.setProperty("/sumQtyTo", aQ.length ? formatter.value(aQ[aQ.length - 1].ValueNew) : "-");                                                                                                                                                     
            oView.setProperty("/sumQtyUom", aQ.length ? (aQ[0].Uom || "") : "");                                                                                                                                                                               
                                                                                                                                                                                                                                                               
            // 변경 횟수 (금액=결과 제외) — 이력은 불변 데이터만                                                                                                                                                                                                                  
            oView.setProperty("/changeCnt", aItems.filter((i) => i.FieldName !== "NETWR").length);                                                                                                                                                             
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // 문서흐름 버튼 → 선택 오더 최신 변경의 상세 팝업                                                                                                                                                                                                                        
        onShowFlow() {                                                                                                                                                                                                                                         
            const sSo = this.getView().getModel("view").getProperty("/selectedSO");                                                                                                                                                                            
            const aItems = (sSo && this._soItems[sSo]) || [];                                                                                                                                                                                                  
            if (!aItems.length) { MessageToast.show("판매오더를 선택하세요."); return; }                                                                                                                                                                                 
            const oLatest = aItems.slice().sort((x, y) => ((y.ErDat && x.ErDat) ? (y.ErDat - x.ErDat) : 0))[0];                                                                                                                                                
            this._buildDetail({ SalesOrder: sSo, ChangeNr: oLatest.ChangeNr });                                                                                                                                                                                
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // ===== 분석탭 =====                                                                                                                                                                                                                                     
        _loadAnalytics() {                                                                                                                                                                                                                                     
            const oModel = this.getOwnerComponent().getModel();                                                                                                                                                                                                
            const oAnalytics = this.getView().getModel("analytics");                                                                                                                                                                                           
            if (!oModel) { return; }                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
            oModel.read("/CustomerChanges", {                                                                                                                                                                                                                  
                success: (oData) => {                                                                                                                                                                                                                          
                    const mCust = {};                                                                                                                                                                                                                          
                    (oData.results || []).forEach((r) => {                                                                                                                                                                                                     
                        const k = r.CustomerNo;                                                                                                                                                                                                                
                        if (!mCust[k]) { mCust[k] = { name: r.CustomerName || r.CustomerNo, count: 0 }; }                                                                                                                                                      
                        mCust[k].count += Number(r.ChangeCount) || 0;                                                                                                                                                                                          
                    });                                                                                                                                                                                                                                        
                    const aTop = Object.keys(mCust)                                                                                                                                                                                                            
                        .map((k) => ({ label: mCust[k].name || k, count: mCust[k].count }))                                                                                                                                                                    
                        .sort((a, b) => b.count - a.count).slice(0, 10);                                                                                                                                                                                       
                    const nMax = Math.max.apply(null, [1].concat(aTop.map((o) => o.count)));                                                                                                                                                                   
                    const nTot = aTop.reduce((s, o) => s + o.count, 0) || 1;                                                                                                                                                                                   
                    aTop.forEach((o, i) => {                                                                                                                                                                                                                   
                        o.rank = i + 1;                                                                                                                                                                                                                        
                        o.pct = Math.round((o.count / nMax) * 100) + "%";                                                                                                                                                                                      
                        o.share = Math.round((o.count / nTot) * 100) + "%";                                                                                                                                                                                    
                    });                                                                                                                                                                                                                                        
                    oAnalytics.setProperty("/custTop", aTop);                                                                                                                                                                                                  
                    oAnalytics.setProperty("/custTotal", nTot);                                                                                                                                                                                                
                    oAnalytics.setProperty("/custCount", aTop.length);                                                                                                                                                                                         
                }                                                                                                                                                                                                                                              
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            this._loadRiskAndAmount();                                                                                                                                                                                                                         
            this._hideChartTitles();                                                                                                                                                                                                                           
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        async _loadRiskAndAmount() {                                                                                                                                                                                                                           
            const oA = this.getView().getModel("analytics");                                                                                                                                                                                                   
            try {                                                                                                                                                                                                                                              
                const aRes = await Promise.all([                                                                                                                                                                                                               
                    this._read("/Stock", [], { "$top": 5000 }),                                                                                                                                                                                                
                    this._read("/ProdIn", [], { "$top": 5000 }),                                                                                                                                                                                               
                    this._read("/ChangeItem", [new Filter("FieldName", FilterOperator.EQ, "KWMENG")], { "$top": 5000 }),                                                                                                                                       
                    this._read("/ChangeItem", [                                                                                                                                                                                                                
                        new Filter("FieldName", FilterOperator.EQ, "NETWR"),                                                                                                                                                                                   
                        new Filter("TabName", FilterOperator.EQ, "ZTC1SD0001")                                                                                                                                                                                 
                    ], { "$top": 5000 })                                                                                                                                                                                                                       
                ]);                                                                                                                                                                                                                                            
                const aStock = aRes[0], aProd = aRes[1], aQty = aRes[2], aAmt = aRes[3];                                                                                                                                                                       
                                                                                                                                                                                                                                                               
                // 자재번호만으로 매칭 (공백 제거) — 플랜트 형식차이로 인한 오매칭 방지                                                                                                                                                                                                    
                const mStock = {}, mProd = {};                                                                                                                                                                                                                 
                aStock.forEach((s) => {                                                                                                                                                                                                                        
                    const k = (s.Matnr || "").trim();                                                                                                                                                                                                          
                    mStock[k] = (mStock[k] || 0) + (Number(s.AvailQty) || 0);                                                                                                                                                                                  
                });                                                                                                                                                                                                                                            
                aProd.forEach((p) => {                                                                                                                                                                                                                         
                    const k = (p.Matnr || "").trim();                                                                                                                                                                                                          
                    mProd[k] = (mProd[k] || 0) + (Number(p.OpenQty) || 0);                                                                                                                                                                                     
                });                                                                                                                                                                                                                                            
                let nOk = 0, nProd = 0, nFail = 0;                                                                                                                                                                                                             
                aQty.forEach((it) => {                                                                                                                                                                                                                         
                    const req = Number(it.CurrentQty) || 0;                                                                                                                                                                                                    
                    const k = (it.Matnr || "").trim();                                                                                                                                                                                                         
                    const avail = mStock[k] || 0, inc = mProd[k] || 0;                                                                                                                                                                                         
                    if (avail >= req) { nOk++; } else if (avail + inc >= req) { nProd++; } else { nFail++; }                                                                                                                                                   
                });                                                                                                                                                                                                                                            
                oA.setProperty("/atpDist", [                                                                                                                                                                                                                   
                    { label: "즉시 출고 가능", count: nOk },                                                                                                                                                                                                         
                    { label: "생산 필요", count: nProd },                                                                                                                                                                                                          
                    { label: "충당 불가", count: nFail }                                                                                                                                                                                                           
                ]);                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                let up = 0, down = 0;                                                                                                                                                                                                                          
                aAmt.forEach((it) => {                                                                                                                                                                                                                         
                    const o = parseFloat(String(it.ValueOld).replace(/,/g, ""));                                                                                                                                                                               
                    const n = parseFloat(String(it.ValueNew).replace(/,/g, ""));                                                                                                                                                                               
                    if (!isNaN(o) && !isNaN(n)) { const d = n - o; if (d > 0) { up += d; } else { down += d; } }                                                                                                                                               
                });                                                                                                                                                                                                                                            
                oA.setProperty("/amtDist", [                                                                                                                                                                                                                   
                    { label: "증가", count: Math.round(up) },                                                                                                                                                                                                    
                    { label: "감소", count: Math.round(Math.abs(down)) }                                                                                                                                                                                         
                ]);                                                                                                                                                                                                                                            
            } catch (e) { /* 메타데이터 미준비 — 패스 */ }                                                                                                                                                                                                               
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // 차트 스타일 — 제목 숨김 + 화려한 색 + 데이터 라벨 (막대는 범례 off → 여백/스크롤 제거)                                                                                                                                                                                            
        _hideChartTitles() {                                                                                                                                                                                                                                   
            const fnSet = (sId, aPalette, bLegend) => {                                                                                                                                                                                                        
                const oC = this.byId(sId);                                                                                                                                                                                                                     
                if (oC && oC.setVizProperties) {                                                                                                                                                                                                               
                    oC.setVizProperties({                                                                                                                                                                                                                      
                        title: { visible: false },                                                                                                                                                                                                             
                        legend: { visible: bLegend },                                                                                                                                                                                                          
                        plotArea: {                                                                                                                                                                                                                            
                            colorPalette: aPalette,                                                                                                                                                                                                            
                            dataLabel: { visible: true }                                                                                                                                                                                                       
                        },                                                                                                                                                                                                                                     
                        general: { background: { color: "transparent" } }                                                                                                                                                                                      
                    });                                                                                                                                                                                                                                        
                }                                                                                                                                                                                                                                              
            };                                                                                                                                                                                                                                                 
            fnSet("chartRisk", ["#2ec4b6", "#ff9f1c", "#ef476f"], false);      // 도넛 → 아래 타일이 범례 역할                                                                                                                                                            
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // ===== 상세 팝업 (ATP + 문서흐름) =====                                                                                                                                                                                                                      
        onCardPress(oEvent) {                                                                                                                                                                                                                                  
            const oData = oEvent.getSource().getBindingContext().getObject();                                                                                                                                                                                  
            this._buildDetail(oData);                                                                                                                                                                                                                          
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        async _buildDetail(oHeader) {                                                                                                                                                                                                                          
            const aAll = await this._read("/ChangeItem",                                                                                                                                                                                                       
                [new Filter("ChangeNr", FilterOperator.EQ, oHeader.ChangeNr)]);                                                                                                                                                                                
            const aItems = aAll.filter((it) => it.FieldName !== "NETWR"); // 금액(결과) 제외                                                                                                                                                                         
                                                                                                                                                                                                                                                               
            const aRows = [];                                                                                                                                                                                                                                  
            for (let i = 0; i < aItems.length; i++) {                                                                                                                                                                                                          
                const it = aItems[i];                                                                                                                                                                                                                          
                const oRow = {                                                                                                                                                                                                                                 
                    levelIcon: formatter.levelIcon(it.TabName),                                                                                                                                                                                                
                    fieldLabel: formatter.fieldLabel(it.FieldName, it.FieldLabel),                                                                                                                                                                             
                    itemText: formatter.itemDisplay(it.SalesOrderItem),                                                                                                                                                                                        
                    valueOld: formatter.value(it.ValueOld),                                                                                                                                                                                                    
                    valueNew: formatter.value(it.ValueNew),                                                                                                                                                                                                    
                    changeState: formatter.changeState(it.ValueOld, it.ValueNew),                                                                                                                                                                              
                    hasAtp: false                                                                                                                                                                                                                              
                };                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
                if (it.Matnr && it.FieldName === "KWMENG") {                                                                                                                                                                                                   
                    const aStock = await this._read("/Stock", [                                                                                                                                                                                                
                        new Filter("Matnr", FilterOperator.EQ, it.Matnr),                                                                                                                                                                                      
                        new Filter("Werks", FilterOperator.EQ, it.PlantTo)                                                                                                                                                                                     
                    ]);                                                                                                                                                                                                                                        
                    const aProd = await this._read("/ProdIn", [                                                                                                                                                                                                
                        new Filter("Matnr", FilterOperator.EQ, it.Matnr),                                                                                                                                                                                      
                        new Filter("Werks", FilterOperator.EQ, it.PlantTo)                                                                                                                                                                                     
                    ]);                                                                                                                                                                                                                                        
                    const nAvail = aStock.length ? Number(aStock[0].AvailQty) : 0;                                                                                                                                                                             
                    const aRcpt = aProd.map((r) => ({ date: r.ReceiptDate, qty: Number(r.OpenQty) }));                                                                                                                                                         
                    const oAtp = formatter.computeAtp(Number(it.CurrentQty), it.RequestedDate, nAvail, aRcpt);                                                                                                                                                 
                    const sUom = it.Uom || "";                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
                    oRow.hasAtp = true;                                                                                                                                                                                                                        
                    oRow.matnr = it.Matnr;                                                                                                                                                                                                                     
                    oRow.plant = it.PlantTo;                                                                                                                                                                                                                   
                    oRow.showIncoming = true;                                                                                                                                                                                                                  
                    oRow.requiredText = formatter.value(String(it.CurrentQty)) + " " + sUom;                                                                                                                                                                   
                                                                                                                                                                                                                                                               
                    const nStockShort = Math.max(0, Number(it.CurrentQty) - oAtp.available);                                                                                                                                                                   
                    oRow.showStockShort = nStockShort > 0;                                                                                                                                                                                                     
                    oRow.stockShortText = "−" + formatter.value(String(nStockShort)) + " " + sUom;                                                                                                                                                             
                                                                                                                                                                                                                                                               
                    oRow.availableText = formatter.value(String(oAtp.available)) + " " + sUom;                                                                                                                                                                 
                    oRow.incomingText = "+" + formatter.value(String(oAtp.incoming)) + " " + sUom;                                                                                                                                                             
                                                                                                                                                                                                                                                               
                    if (!oAtp.covered) {                                                                                                                                                                                                                       
                        oRow.shipDateText = "-";                                                                                                                                                                                                               
                        oRow.statusText = "충당 불가 (부족 " + formatter.value(String(oAtp.shortage)) + " " + sUom + ")";                                                                                                                                            
                        oRow.statusState = "Error";                                                                                                                                                                                                            
                        oRow.statusIcon = "sap-icon://error";                                                                                                                                                                                                  
                    } else if (oAtp.immediate) {                                                                                                                                                                                                               
                        oRow.shipDateText = "즉시 가능";                                                                                                                                                                                                           
                        oRow.statusText = "즉시 출고 가능 (현재고 충분)";                                                                                                                                                                                                 
                        oRow.statusState = "Success";                                                                                                                                                                                                          
                        oRow.statusIcon = "sap-icon://sys-enter-2";                                                                                                                                                                                            
                    } else if (oAtp.delayDays === null || oAtp.delayDays <= 0) {                                                                                                                                                                               
                        oRow.shipDateText = this._fmtDate(oAtp.shipDate);                                                                                                                                                                                      
                        oRow.statusText = "납기 가능 (요청일 내 출고)";                                                                                                                                                                                                  
                        oRow.statusState = "Success";                                                                                                                                                                                                          
                        oRow.statusIcon = "sap-icon://sys-enter-2";                                                                                                                                                                                            
                    } else {                                                                                                                                                                                                                                   
                        oRow.shipDateText = this._fmtDate(oAtp.shipDate);                                                                                                                                                                                      
                        oRow.statusText = oAtp.delayDays + "일 지연 (요청 " + this._fmtDate(it.RequestedDate) + ")";                                                                                                                                                
                        oRow.statusState = "Warning";                                                                                                                                                                                                          
                        oRow.statusIcon = "sap-icon://alert";                                                                                                                                                                                                  
                    }                                                                                                                                                                                                                                          
                }                                                                                                                                                                                                                                              
                aRows.push(oRow);                                                                                                                                                                                                                              
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            const aFlow = await this._buildFlow(oHeader.SalesOrder);                                                                                                                                                                                           
            let sFlowText;                                                                                                                                                                                                                                     
            if (aFlow.length <= 1) {                                                                                                                                                                                                                           
                sFlowText = "후속 문서 없음 (납품/청구 미생성)";                                                                                                                                                                                                            
            } else {                                                                                                                                                                                                                                           
                sFlowText = aFlow.map((f) =>                                                                                                                                                                                                                   
                    formatter.docTypeText(f.t) + " " + formatter.soDisplay(f.no)).join("   →   ");                                                                                                                                                             
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            this.getView().setModel(new JSONModel({                                                                                                                                                                                                            
                orderText: formatter.soDisplay(oHeader.SalesOrder),                                                                                                                                                                                            
                flowText: sFlowText,                                                                                                                                                                                                                           
                items: aRows                                                                                                                                                                                                                                   
            }), "detail");                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
            this._openDialog();                                                                                                                                                                                                                                
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        async _buildFlow(sSo) {                                                                                                                                                                                                                                
            const aFlow = [{ t: "C", no: sSo }];                                                                                                                                                                                                               
            const oSeen = new Set([sSo]);                                                                                                                                                                                                                      
            let aFrontier = [sSo];                                                                                                                                                                                                                             
            for (let hop = 0; hop < 3 && aFrontier.length; hop++) {                                                                                                                                                                                            
                const aNext = [];                                                                                                                                                                                                                              
                for (let i = 0; i < aFrontier.length; i++) {                                                                                                                                                                                                   
                    const aRows = await this._read("/DocFlow",                                                                                                                                                                                                 
                        [new Filter("Vbelv", FilterOperator.EQ, aFrontier[i])]);                                                                                                                                                                               
                    aRows.forEach((r) => {                                                                                                                                                                                                                     
                        const sNo = (r.Vbeln || "").replace(/^[0\s]+$/, "").trim();                                                                                                                                                                            
                        if (sNo && r.Vbeln && !oSeen.has(r.Vbeln)) {                                                                                                                                                                                           
                            oSeen.add(r.Vbeln);                                                                                                                                                                                                                
                            aFlow.push({ t: r.VbtypN, no: r.Vbeln });                                                                                                                                                                                          
                            aNext.push(r.Vbeln);                                                                                                                                                                                                               
                        }                                                                                                                                                                                                                                      
                    });                                                                                                                                                                                                                                        
                }                                                                                                                                                                                                                                              
                aFrontier = aNext;                                                                                                                                                                                                                             
            }                                                                                                                                                                                                                                                  
            return aFlow;                                                                                                                                                                                                                                      
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _openDialog() {                                                                                                                                                                                                                                        
            const that = this;                                                                                                                                                                                                                                 
            if (!this._pDialog) {                                                                                                                                                                                                                              
                this._pDialog = Fragment.load({                                                                                                                                                                                                                
                    id: this.getView().getId(),                                                                                                                                                                                                                
                    name: "c1.sd.c1sdso.view.ChangeDetail",                                                                                                                                                                                                    
                    controller: this                                                                                                                                                                                                                           
                }).then((oDialog) => { that.getView().addDependent(oDialog); return oDialog; });                                                                                                                                                               
            }                                                                                                                                                                                                                                                  
            this._pDialog.then((oDialog) => oDialog.open());                                                                                                                                                                                                   
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onCloseDetail() {                                                                                                                                                                                                                                      
            this._pDialog.then((oDialog) => oDialog.close());                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _read(sPath, aFilters, oParams) {                                                                                                                                                                                                                      
            const oModel = this.getOwnerComponent().getModel();                                                                                                                                                                                                
            return new Promise((resolve, reject) => {                                                                                                                                                                                                          
                oModel.read(sPath, {                                                                                                                                                                                                                           
                    filters: aFilters,                                                                                                                                                                                                                         
                    urlParameters: oParams,                                                                                                                                                                                                                    
                    success: (oData) => resolve(oData.results || []),                                                                                                                                                                                          
                    error: reject                                                                                                                                                                                                                              
                });                                                                                                                                                                                                                                            
            });                                                                                                                                                                                                                                                
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onExport() {                                                                                                                                                                                                                                           
            const oModel = this.getOwnerComponent().getModel();                                                                                                                                                                                                
            const aCols = [                                                                                                                                                                                                                                    
                { label: "판매오더", property: "SoF" },                                                                                                                                                                                                            
                { label: "품목", property: "ItemF" },                                                                                                                                                                                                            
                { label: "구분", property: "ChangeLevelText" },                                                                                                                                                                                                  
                { label: "변경필드", property: "FieldLabelF" },                                                                                                                                                                                                    
                { label: "변경 전", property: "ValueOldF" },                                                                                                                                                                                                      
                { label: "변경 후", property: "ValueNewF" },                                                                                                                                                                                                      
                { label: "변경자", property: "UserF" },                                                                                                                                                                                                           
                { label: "변경일", property: "ErDat", type: "date", format: "yyyy.mm.dd" }                                                                                                                                                                        
            ];                                                                                                                                                                                                                                                 
            oModel.read("/ChangeItem", {                                                                                                                                                                                                                       
                filters: this._aFilters,                                                                                                                                                                                                                       
                urlParameters: { "$top": 5000 },                                                                                                                                                                                                               
                success: (oData) => {                                                                                                                                                                                                                          
                    const aData = (oData.results || [])                                                                                                                                                                                                        
                        .filter((r) => r.FieldName !== "NETWR") // 금액(결과) 제외                                                                                                                                                                                   
                        .map((r) => Object.assign({}, r, {                                                                                                                                                                                                     
                            SoF: formatter.soDisplay(r.SalesOrder),                                                                                                                                                                                            
                            ItemF: formatter.itemDisplay(r.SalesOrderItem),                                                                                                                                                                                    
                            FieldLabelF: formatter.fieldLabel(r.FieldName, r.FieldLabel),                                                                                                                                                                      
                            ValueOldF: formatter.value(r.ValueOld),                                                                                                                                                                                            
                            ValueNewF: formatter.value(r.ValueNew),                                                                                                                                                                                            
                            UserF: this._userName(r)                                                                                                                                                                                                           
                        }));                                                                                                                                                                                                                                   
                    new Spreadsheet({                                                                                                                                                                                                                          
                        workbook: { columns: aCols },                                                                                                                                                                                                          
                        dataSource: aData,                                                                                                                                                                                                                     
                        fileName: "판매오더_변경이력.xlsx"                                                                                                                                                                                                             
                    }).build().finally(function () { MessageToast.show("엑셀 다운로드 완료"); });                                                                                                                                                                      
                }                                                                                                                                                                                                                                              
            });                                                                                                                                                                                                                                                
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _fmtDate(d) {                                                                                                                                                                                                                                          
            if (!(d instanceof Date)) { return "-"; }                                                                                                                                                                                                          
            const p = (n) => (n < 10 ? "0" + n : "" + n);                                                                                                                                                                                                      
            return d.getFullYear() + "." + p(d.getMonth() + 1) + "." + p(d.getDate());                                                                                                                                                                         
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // 변경자 표시: "최유정 대리" (HR 이름+직급, 없으면 ID)                                                                                                                                                                                                                 
        _userName(oItem) {                                                                                                                                                                                                                                     
            if (!oItem) { return "-"; }                                                                                                                                                                                                                        
            const sName = oItem.ChangeUserName || oItem.ErNam || "-";                                                                                                                                                                                          
            return oItem.ChangeUserGrade ? (sName + " " + oItem.ChangeUserGrade) : sName;                                                                                                                                                                      
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _fmtAmt(n) {                                                                                                                                                                                                                                           
            const v = Math.round(n);                                                                                                                                                                                                                           
            return (v > 0 ? "+" : "") + v.toLocaleString();                                                                                                                                                                                                    
        }                                                                                                                                                                                                                                                      
    });                                                                                                                                                                                                                                                        
});                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               