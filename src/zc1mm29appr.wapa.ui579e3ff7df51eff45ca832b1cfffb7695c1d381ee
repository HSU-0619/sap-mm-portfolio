sap.ui.define(                                                                                                                                                                                                                                                 
  [                                                                                                                                                                                                                                                            
    "sap/ui/core/mvc/Controller",                                                                                                                                                                                                                              
    "sap/ui/model/json/JSONModel",                                                                                                                                                                                                                             
    "sap/ui/model/Filter",                                                                                                                                                                                                                                     
    "sap/ui/model/FilterOperator",                                                                                                                                                                                                                             
    "sap/m/MessageToast",                                                                                                                                                                                                                                      
    "sap/m/MessageBox",                                                                                                                                                                                                                                        
    "sap/m/Dialog",                                                                                                                                                                                                                                            
    "sap/m/TextArea",                                                                                                                                                                                                                                          
    "sap/m/Button",                                                                                                                                                                                                                                            
    "sap/m/Label",                                                                                                                                                                                                                                             
    "sap/m/VBox",                                                                                                                                                                                                                                              
  ],                                                                                                                                                                                                                                                           
  function (                                                                                                                                                                                                                                                   
    Controller,                                                                                                                                                                                                                                                
    JSONModel,                                                                                                                                                                                                                                                 
    Filter,                                                                                                                                                                                                                                                    
    FilterOperator,                                                                                                                                                                                                                                            
    MessageToast,                                                                                                                                                                                                                                              
    MessageBox,                                                                                                                                                                                                                                                
    Dialog,                                                                                                                                                                                                                                                    
    TextArea,                                                                                                                                                                                                                                                  
    Button,                                                                                                                                                                                                                                                    
    Label,                                                                                                                                                                                                                                                     
    VBox,                                                                                                                                                                                                                                                      
  ) {                                                                                                                                                                                                                                                          
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    // 단가 보정 배율 (실제 데이터 보고 조정)                                                                                                                                                                                                                                 
    var PRICE_FACTOR = 100;                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
    return Controller.extend("cl3.c1.mm.mmapproval.controller.POapprovalView", {                                                                                                                                                                               
      /**********************************************************************                                                                                                                                                                                  
       * 초기화                                                                                                                                                                                                                                                   
       **********************************************************************/                                                                                                                                                                                 
      onInit: function () {                                                                                                                                                                                                                                    
        var oUIModel = new JSONModel({                                                                                                                                                                                                                         
          hasSelection: false,                                                                                                                                                                                                                                 
          selectedEbeln: "",                                                                                                                                                                                                                                   
          countText: "0",                                                                                                                                                                                                                                      
        });                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
        this.getView().setModel(oUIModel, "ui");                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
        this._pendingEbeln = this._getEbelnFromUrl();                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
        var oTable = this.byId("tblHeader");                                                                                                                                                                                                                   
        oTable.attachUpdateFinished(                                                                                                                                                                                                                           
          function () {                                                                                                                                                                                                                                        
            this._updateCountText();                                                                                                                                                                                                                           
            this._tryAutoSelect();                                                                                                                                                                                                                             
          }.bind(this),                                                                                                                                                                                                                                        
        );                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        setTimeout(                                                                                                                                                                                                                                            
          function () {                                                                                                                                                                                                                                        
            this._applyDefaultFilter();                                                                                                                                                                                                                        
          }.bind(this),                                                                                                                                                                                                                                        
          300,                                                                                                                                                                                                                                                 
        );                                                                                                                                                                                                                                                     
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      _getEbelnFromUrl: function () {                                                                                                                                                                                                                          
        var oParams = new URLSearchParams(window.location.search);                                                                                                                                                                                             
        return oParams.get("ebeln") || "";                                                                                                                                                                                                                     
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      /**********************************************************************                                                                                                                                                                                  
       * Formatter                                                                                                                                                                                                                                             
       **********************************************************************/                                                                                                                                                                                 
      formatDate: function (oDate) {                                                                                                                                                                                                                           
        if (!oDate) return "";                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
        if (oDate instanceof Date) {                                                                                                                                                                                                                           
          var sYear = oDate.getFullYear();                                                                                                                                                                                                                     
          var sMonth = String(oDate.getMonth() + 1).padStart(2, "0");                                                                                                                                                                                          
          var sDay = String(oDate.getDate()).padStart(2, "0");                                                                                                                                                                                                 
          return sYear + "-" + sMonth + "-" + sDay;                                                                                                                                                                                                            
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        if (typeof oDate === "string" && oDate.length === 8) {                                                                                                                                                                                                 
          return (                                                                                                                                                                                                                                             
            oDate.substring(0, 4) +                                                                                                                                                                                                                            
            "-" +                                                                                                                                                                                                                                              
            oDate.substring(4, 6) +                                                                                                                                                                                                                            
            "-" +                                                                                                                                                                                                                                              
            oDate.substring(6, 8)                                                                                                                                                                                                                              
          );                                                                                                                                                                                                                                                   
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        return String(oDate);                                                                                                                                                                                                                                  
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      formatPrice: function (vValue) {                                                                                                                                                                                                                         
        if (vValue === null || vValue === undefined || vValue === "") return "";                                                                                                                                                                               
                                                                                                                                                                                                                                                               
        var nValue = parseFloat(vValue);                                                                                                                                                                                                                       
        if (isNaN(nValue)) return "";                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
        // OData Scale 보정                                                                                                                                                                                                                                      
        nValue = nValue * PRICE_FACTOR;                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
        return nValue.toLocaleString("ko-KR", {                                                                                                                                                                                                                
          minimumFractionDigits: 0,                                                                                                                                                                                                                            
          maximumFractionDigits: 0,                                                                                                                                                                                                                            
        });                                                                                                                                                                                                                                                    
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      formatQty: function (vValue) {                                                                                                                                                                                                                           
        if (vValue === null || vValue === undefined || vValue === "") return "";                                                                                                                                                                               
                                                                                                                                                                                                                                                               
        var nValue = parseFloat(vValue);                                                                                                                                                                                                                       
        if (isNaN(nValue)) return "";                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
        return nValue.toLocaleString("ko-KR", {                                                                                                                                                                                                                
          maximumFractionDigits: 3,                                                                                                                                                                                                                            
        });                                                                                                                                                                                                                                                    
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      formatTotal: function (vMenge, vNetpr) {                                                                                                                                                                                                                 
        if (!vMenge || !vNetpr) return "";                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        var nMenge = parseFloat(vMenge);                                                                                                                                                                                                                       
        var nNetpr = parseFloat(vNetpr) * PRICE_FACTOR;                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
        if (isNaN(nMenge) || isNaN(nNetpr)) return "";                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
        return (nMenge * nNetpr).toLocaleString("ko-KR", {                                                                                                                                                                                                     
          minimumFractionDigits: 0,                                                                                                                                                                                                                            
          maximumFractionDigits: 0,                                                                                                                                                                                                                            
        });                                                                                                                                                                                                                                                    
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      /**********************************************************************                                                                                                                                                                                  
       * 기본 필터 (결재 대기 PD)                                                                                                                                                                                                                                      
       **********************************************************************/                                                                                                                                                                                 
      _applyDefaultFilter: function () {                                                                                                                                                                                                                       
        var oTable = this.byId("tblHeader");                                                                                                                                                                                                                   
        var oBinding = oTable.getBinding("items");                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
        if (!oBinding) {                                                                                                                                                                                                                                       
          return;                                                                                                                                                                                                                                              
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        oBinding.filter([new Filter("Statu", FilterOperator.EQ, "PD")]);                                                                                                                                                                                       
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      /**********************************************************************                                                                                                                                                                                  
       * 조회                                                                                                                                                                                                                                                    
       **********************************************************************/                                                                                                                                                                                 
      onSearch: function () {                                                                                                                                                                                                                                  
        var oTable = this.byId("tblHeader");                                                                                                                                                                                                                   
        var oBinding = oTable.getBinding("items");                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
        if (!oBinding) {                                                                                                                                                                                                                                       
          return;                                                                                                                                                                                                                                              
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        var aFilters = [];                                                                                                                                                                                                                                     
        var sEbeln = this.byId("inpEbeln").getValue().trim();                                                                                                                                                                                                  
        var sLifnr = this.byId("inpLifnr").getValue().trim();                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
        aFilters.push(new Filter("Statu", FilterOperator.EQ, "PD"));                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
        if (sEbeln) {                                                                                                                                                                                                                                          
          aFilters.push(new Filter("Ebeln", FilterOperator.Contains, sEbeln));                                                                                                                                                                                 
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        if (sLifnr) {                                                                                                                                                                                                                                          
          aFilters.push(new Filter("Lifnr", FilterOperator.Contains, sLifnr));                                                                                                                                                                                 
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        oBinding.filter(aFilters);                                                                                                                                                                                                                             
        this._clearDetail();                                                                                                                                                                                                                                   
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      /**********************************************************************                                                                                                                                                                                  
       * 초기화                                                                                                                                                                                                                                                   
       **********************************************************************/                                                                                                                                                                                 
      onReset: function () {                                                                                                                                                                                                                                   
        this.byId("inpEbeln").setValue("");                                                                                                                                                                                                                    
        this.byId("inpLifnr").setValue("");                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
        var oTable = this.byId("tblHeader");                                                                                                                                                                                                                   
        var oBinding = oTable.getBinding("items");                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
        if (oBinding) {                                                                                                                                                                                                                                        
          oBinding.filter([new Filter("Statu", FilterOperator.EQ, "PD")]);                                                                                                                                                                                     
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        this._clearDetail();                                                                                                                                                                                                                                   
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      /**********************************************************************                                                                                                                                                                                  
       * 행 선택                                                                                                                                                                                                                                                  
       **********************************************************************/                                                                                                                                                                                 
      onSelectionChange: function (oEvent) {                                                                                                                                                                                                                   
        var oItem = oEvent.getParameter("listItem");                                                                                                                                                                                                           
        var oContext = oItem.getBindingContext();                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
        if (!oContext) {                                                                                                                                                                                                                                       
          return;                                                                                                                                                                                                                                              
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        this.byId("detailPanel").bindElement({                                                                                                                                                                                                                 
          path: oContext.getPath(),                                                                                                                                                                                                                            
        });                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
        var oUIModel = this.getView().getModel("ui");                                                                                                                                                                                                          
        oUIModel.setProperty("/hasSelection", true);                                                                                                                                                                                                           
        oUIModel.setProperty("/selectedEbeln", oContext.getProperty("Ebeln"));                                                                                                                                                                                 
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      /**********************************************************************                                                                                                                                                                                  
       * 승인                                                                                                                                                                                                                                                    
       **********************************************************************/                                                                                                                                                                                 
      onApprove: function () {                                                                                                                                                                                                                                 
        var oContext = this.byId("detailPanel").getBindingContext();                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
        if (!oContext) {                                                                                                                                                                                                                                       
          MessageBox.warning("승인할 구매오더를 먼저 선택하세요.");                                                                                                                                                                                                           
          return;                                                                                                                                                                                                                                              
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        MessageBox.confirm("선택한 구매오더를 승인하시겠습니까?", {                                                                                                                                                                                                            
          title: "승인 확인",                                                                                                                                                                                                                                      
          actions: [MessageBox.Action.OK, MessageBox.Action.CANCEL],                                                                                                                                                                                           
          emphasizedAction: MessageBox.Action.OK,                                                                                                                                                                                                              
          onClose: function (sAction) {                                                                                                                                                                                                                        
            if (sAction === MessageBox.Action.OK) {                                                                                                                                                                                                            
              this._callAction("approve", {});                                                                                                                                                                                                                 
            }                                                                                                                                                                                                                                                  
          }.bind(this),                                                                                                                                                                                                                                        
        });                                                                                                                                                                                                                                                    
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      /**********************************************************************                                                                                                                                                                                  
       * 반려 다이얼로그                                                                                                                                                                                                                                              
       **********************************************************************/                                                                                                                                                                                 
      onOpenRejectDialog: function () {                                                                                                                                                                                                                        
        var oContext = this.byId("detailPanel").getBindingContext();                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
        if (!oContext) {                                                                                                                                                                                                                                       
          MessageBox.warning("반려할 구매오더를 먼저 선택하세요.");                                                                                                                                                                                                           
          return;                                                                                                                                                                                                                                              
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        if (!this._oRejectDialog) {                                                                                                                                                                                                                            
          this._oRejectTextArea = new TextArea({                                                                                                                                                                                                               
            width: "100%",                                                                                                                                                                                                                                     
            rows: 6,                                                                                                                                                                                                                                           
            placeholder: "반려 사유를 입력하세요.",                                                                                                                                                                                                                      
          });                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
          this._oRejectDialog = new Dialog({                                                                                                                                                                                                                   
            title: "반려 사유 입력",                                                                                                                                                                                                                                 
            contentWidth: "500px",                                                                                                                                                                                                                             
            content: new VBox({                                                                                                                                                                                                                                
              items: [                                                                                                                                                                                                                                         
                new Label({                                                                                                                                                                                                                                    
                  text: "반려 사유",                                                                                                                                                                                                                               
                  required: true,                                                                                                                                                                                                                              
                }).addStyleClass("sapUiTinyMarginBottom"),                                                                                                                                                                                                     
                this._oRejectTextArea,                                                                                                                                                                                                                         
              ],                                                                                                                                                                                                                                               
            }).addStyleClass("sapUiSmallMargin"),                                                                                                                                                                                                              
            beginButton: new Button({                                                                                                                                                                                                                          
              text: "반려",                                                                                                                                                                                                                                      
              type: "Reject",                                                                                                                                                                                                                                  
              icon: "sap-icon://decline",                                                                                                                                                                                                                      
              press: function () {                                                                                                                                                                                                                             
                var sReason = this._oRejectTextArea.getValue().trim();                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
                if (!sReason) {                                                                                                                                                                                                                                
                  MessageBox.warning("반려 사유를 입력하세요.");                                                                                                                                                                                                         
                  return;                                                                                                                                                                                                                                      
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                this._oRejectDialog.close();                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
                this._callAction("reject", {                                                                                                                                                                                                                   
                  Bigo: sReason,                                                                                                                                                                                                                               
                });                                                                                                                                                                                                                                            
              }.bind(this),                                                                                                                                                                                                                                    
            }),                                                                                                                                                                                                                                                
            endButton: new Button({                                                                                                                                                                                                                            
              text: "취소",                                                                                                                                                                                                                                      
              press: function () {                                                                                                                                                                                                                             
                this._oRejectDialog.close();                                                                                                                                                                                                                   
              }.bind(this),                                                                                                                                                                                                                                    
            }),                                                                                                                                                                                                                                                
            afterClose: function () {                                                                                                                                                                                                                          
              this._oRejectTextArea.setValue("");                                                                                                                                                                                                              
            }.bind(this),                                                                                                                                                                                                                                      
          });                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
          this.getView().addDependent(this._oRejectDialog);                                                                                                                                                                                                    
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        this._oRejectDialog.open();                                                                                                                                                                                                                            
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      /**********************************************************************                                                                                                                                                                                  
       * 액션 호출 (V2 FunctionImport)                                                                                                                                                                                                                             
       **********************************************************************/                                                                                                                                                                                 
      _callAction: function (sActionName, oExtraParams) {                                                                                                                                                                                                      
        var oView = this.getView();                                                                                                                                                                                                                            
        var oModel = oView.getModel();                                                                                                                                                                                                                         
        var oContext = this.byId("detailPanel").getBindingContext();                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
        if (!oContext) {                                                                                                                                                                                                                                       
          MessageBox.warning("선택된 데이터가 없습니다.");                                                                                                                                                                                                                
          return;                                                                                                                                                                                                                                              
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        var sEbeln = oContext.getProperty("Ebeln");                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
        var oUrlParams = {                                                                                                                                                                                                                                     
          Ebeln: sEbeln,                                                                                                                                                                                                                                       
        };                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        if (oExtraParams) {                                                                                                                                                                                                                                    
          Object.keys(oExtraParams).forEach(function (sKey) {                                                                                                                                                                                                  
            oUrlParams[sKey] = oExtraParams[sKey];                                                                                                                                                                                                             
          });                                                                                                                                                                                                                                                  
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        console.log("=== ACTION DEBUG ===");                                                                                                                                                                                                                   
        console.log("Action     :", sActionName);                                                                                                                                                                                                              
        console.log("URL Params :", oUrlParams);                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
        oView.setBusy(true);                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
        oModel.callFunction("/" + sActionName, {                                                                                                                                                                                                               
          method: "POST",                                                                                                                                                                                                                                      
          urlParameters: oUrlParams,                                                                                                                                                                                                                           
          success: function (oData) {                                                                                                                                                                                                                          
            console.log("Action Success:", oData);                                                                                                                                                                                                             
            oView.setBusy(false);                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
            MessageToast.show(                                                                                                                                                                                                                                 
              sActionName === "approve"                                                                                                                                                                                                                        
                ? "승인 처리되었습니다."                                                                                                                                                                                                                                
                : "반려 처리되었습니다.",                                                                                                                                                                                                                               
            );                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            this._clearDetail();                                                                                                                                                                                                                               
            oModel.refresh(true);                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
            setTimeout(                                                                                                                                                                                                                                        
              function () {                                                                                                                                                                                                                                    
                this._applyDefaultFilter();                                                                                                                                                                                                                    
              }.bind(this),                                                                                                                                                                                                                                    
              300,                                                                                                                                                                                                                                             
            );                                                                                                                                                                                                                                                 
          }.bind(this),                                                                                                                                                                                                                                        
          error: function (oError) {                                                                                                                                                                                                                           
            console.error("Action Error:", oError);                                                                                                                                                                                                            
            oView.setBusy(false);                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
            var sMsg = "액션 호출 실패";                                                                                                                                                                                                                             
            try {                                                                                                                                                                                                                                              
              if (oError && oError.responseText) {                                                                                                                                                                                                             
                var oErr = JSON.parse(oError.responseText);                                                                                                                                                                                                    
                if (                                                                                                                                                                                                                                           
                  oErr &&                                                                                                                                                                                                                                      
                  oErr.error &&                                                                                                                                                                                                                                
                  oErr.error.message &&                                                                                                                                                                                                                        
                  oErr.error.message.value                                                                                                                                                                                                                     
                ) {                                                                                                                                                                                                                                            
                  sMsg = oErr.error.message.value;                                                                                                                                                                                                             
                }                                                                                                                                                                                                                                              
              }                                                                                                                                                                                                                                                
            } catch (e) {}                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
            MessageBox.error(sMsg);                                                                                                                                                                                                                            
          },                                                                                                                                                                                                                                                   
        });                                                                                                                                                                                                                                                    
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      /**********************************************************************                                                                                                                                                                                  
       * 상세 영역 초기화                                                                                                                                                                                                                                             
       **********************************************************************/                                                                                                                                                                                 
      _clearDetail: function () {                                                                                                                                                                                                                              
        this.byId("detailPanel").unbindElement();                                                                                                                                                                                                              
        var oUIModel = this.getView().getModel("ui");                                                                                                                                                                                                          
        oUIModel.setProperty("/hasSelection", false);                                                                                                                                                                                                          
        oUIModel.setProperty("/selectedEbeln", "");                                                                                                                                                                                                            
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      /**********************************************************************                                                                                                                                                                                  
       * URL에서 받은 EBELN 자동 선택                                                                                                                                                                                                                                  
       **********************************************************************/                                                                                                                                                                                 
      _tryAutoSelect: function () {                                                                                                                                                                                                                            
        if (!this._pendingEbeln) {                                                                                                                                                                                                                             
          return;                                                                                                                                                                                                                                              
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        var sEbeln = String(this._pendingEbeln).trim();                                                                                                                                                                                                        
        var oTable = this.byId("tblHeader");                                                                                                                                                                                                                   
        var aItems = oTable.getItems();                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
        if (aItems.length === 0) {                                                                                                                                                                                                                             
          return;                                                                                                                                                                                                                                              
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        for (var i = 0; i < aItems.length; i++) {                                                                                                                                                                                                              
          var oItem = aItems[i];                                                                                                                                                                                                                               
          var oCtx = oItem.getBindingContext();                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
          if (!oCtx) {                                                                                                                                                                                                                                         
            continue;                                                                                                                                                                                                                                          
          }                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
          var sRowEbeln = String(oCtx.getProperty("Ebeln")).trim();                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
          if (sRowEbeln === sEbeln) {                                                                                                                                                                                                                          
            // 왼쪽 목록 행 선택 표시                                                                                                                                                                                                                                   
            oTable.setSelectedItem(oItem, true);                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
            // 오른쪽 상세 정보 바인딩                                                                                                                                                                                                                                   
            this.byId("detailPanel").bindElement({                                                                                                                                                                                                             
              path: oCtx.getPath(),                                                                                                                                                                                                                            
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            // 우측 상세 표시 상태 변경                                                                                                                                                                                                                                  
            var oUIModel = this.getView().getModel("ui");                                                                                                                                                                                                      
            oUIModel.setProperty("/hasSelection", true);                                                                                                                                                                                                       
            oUIModel.setProperty("/selectedEbeln", sRowEbeln);                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            this._pendingEbeln = "";                                                                                                                                                                                                                           
            return;                                                                                                                                                                                                                                            
          }                                                                                                                                                                                                                                                    
        }                                                                                                                                                                                                                                                      
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      /**********************************************************************                                                                                                                                                                                  
       * 결재 대기 건수 갱신                                                                                                                                                                                                                                           
       **********************************************************************/                                                                                                                                                                                 
      _updateCountText: function () {                                                                                                                                                                                                                          
        var oTable = this.byId("tblHeader");                                                                                                                                                                                                                   
        var oBinding = oTable.getBinding("items");                                                                                                                                                                                                             
        var oUIModel = this.getView().getModel("ui");                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
        if (!oBinding) {                                                                                                                                                                                                                                       
          oUIModel.setProperty("/countText", "0");                                                                                                                                                                                                             
          return;                                                                                                                                                                                                                                              
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        var iLength = 0;                                                                                                                                                                                                                                       
        try {                                                                                                                                                                                                                                                  
          if (oBinding.getCount && oBinding.getCount() !== undefined) {                                                                                                                                                                                        
            iLength = oBinding.getCount();                                                                                                                                                                                                                     
          } else {                                                                                                                                                                                                                                             
            iLength = oBinding.getLength();                                                                                                                                                                                                                    
          }                                                                                                                                                                                                                                                    
        } catch (e) {                                                                                                                                                                                                                                          
          iLength = 0;                                                                                                                                                                                                                                         
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        oUIModel.setProperty("/countText", String(iLength));                                                                                                                                                                                                   
      },                                                                                                                                                                                                                                                       
    });                                                                                                                                                                                                                                                        
  },                                                                                                                                                                                                                                                           
);                                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               