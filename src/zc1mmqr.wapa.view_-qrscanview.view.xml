<mvc:View                                                                                                                                                                                                                                                      
    controllerName="c1.mm.c1mmqr.controller.qrScanView"                                                                                                                                                                                                        
    xmlns:mvc="sap.ui.core.mvc"                                                                                                                                                                                                                                
    xmlns="sap.m"                                                                                                                                                                                                                                              
    xmlns:core="sap.ui.core"                                                                                                                                                                                                                                   
    displayBlock="true">                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
    <Page id="scanPage" showHeader="false" enableScrolling="true" class="sapUiNoContentPadding qrScanPage">                                                                                                                                                    
        <content>                                                                                                                                                                                                                                              
            <VBox class="qrScanRoot qrScanV2">                                                                                                                                                                                                                 
                <HBox class="qrScanWrap" renderType="Bare">                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
                    <!-- ===== LEFT : 스캔 입력 + 스캔 이력 ===== -->                                                                                                                                                                                                  
                    <VBox class="qrScanLeft">                                                                                                                                                                                                                  
                        <VBox class="qrScanCard">                                                                                                                                                                                                              
                            <HBox class="qrScanSecHead" alignItems="Center">                                                                                                                                                                                   
                                <core:Icon src="sap-icon://qr-code" size="1rem" color="#0A6ED1"/>                                                                                                                                                              
                                <Title text="QR 스캔" level="H5" class="qrScanSecTitle"/>                                                                                                                                                                        
                            </HBox>                                                                                                                                                                                                                            
                            <Button id="btnStartScan" text="카메라로 스캔" type="Emphasized" icon="sap-icon://camera" press="onStartScan" width="100%" class="sapUiSmallMarginTop"/>                                                                                 
                            <Label text="또는 QR번호 직접 입력" class="qrScanIdleHint sapUiSmallMarginTop"/>                                                                                                                                                           
                            <HBox alignItems="Center" class="sapUiTinyMarginTop">                                                                                                                                                                              
                                <Input id="inManualQr" placeholder="QR번호" width="100%" submit="onManualSearch"/>                                                                                                                                               
                                <Button text="조회" type="Emphasized" icon="sap-icon://search" press="onManualSearch" class="sapUiTinyMarginBegin"/>                                                                                                             
                            </HBox>                                                                                                                                                                                                                            
                            <Button text="초기화" type="Emphasized" icon="sap-icon://undo" press="onClearResult" width="100%" class="sapUiSmallMarginTop"/>                                                                                                       
                        </VBox>                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
                        <VBox class="qrScanCard sapUiSmallMarginTop">                                                                                                                                                                                          
                            <HBox class="qrScanSecHead" alignItems="Center">                                                                                                                                                                                   
                                <core:Icon src="sap-icon://history" size="1rem" color="#8696a9"/>                                                                                                                                                              
                                <Title text="스캔 이력" level="H5" class="qrScanSecTitle"/>                                                                                                                                                                        
                            </HBox>                                                                                                                                                                                                                            
                            <List id="rScanHistList" noDataText="스캔 이력 없음" class="qrHistList"/>                                                                                                                                                                
                        </VBox>                                                                                                                                                                                                                                
                    </VBox>                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
                    <!-- ===== RIGHT : 결과 ===== -->                                                                                                                                                                                                            
                    <VBox class="qrScanRight">                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
                        <!-- 빈 상태 -->                                                                                                                                                                                                                          
                        <VBox id="scanEmpty" class="qrScanCard qrScanEmpty" alignItems="Center" justifyContent="Center">                                                                                                                                       
                            <core:Icon src="sap-icon://bar-code" size="3rem" color="#B0B8C1"/>                                                                                                                                                                 
                            <Title text="QR을 스캔하세요" level="H4" class="sapUiSmallMarginTop"/>                                                                                                                                                                   
                            <Text text="왼쪽에서 카메라로 스캔하거나 QR번호를 입력하면 결과가 표시됩니다." textAlign="Center" wrapping="true" class="qrScanIdleHint sapUiTinyMarginTop"/>                                                                                                  
                        </VBox>                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
                        <!-- 결과 -->                                                                                                                                                                                                                            
                        <VBox id="scanResultBox" visible="false">                                                                                                                                                                                              
                            <!-- HERO -->                                                                                                                                                                                                                      
                            <VBox class="qrScanCard">                                                                                                                                                                                                          
                                <HBox class="qrScanHero" alignItems="Center">                                                                                                                                                                                  
                                    <VBox class="qrScanHeroImg">                                                                                                                                                                                               
                                        <Image id="rMatImg" width="11rem" densityAware="false" error="onScanImgError"/>                                                                                                                                        
                                        <core:Icon id="rMatImgFallback" src="sap-icon://product" size="5rem" color="#B0B8C1" visible="false" class="qrDashImgFallback"/>                                                                                       
                                    </VBox>                                                                                                                                                                                                                    
                                    <VBox class="qrScanHeroMain">                                                                                                                                                                                              
                                        <HBox alignItems="Center" class="qrScanTitleRow">                                                                                                                                                                      
                                            <Title id="rMatnr" text="" level="H3" class="qrScanMatnr"/>                                                                                                                                                        
                                            <core:HTML id="rStatusBadge" content="" preferDOM="false" class="sapUiTinyMarginBegin"/>                                                                                                                           
                                        </HBox>                                                                                                                                                                                                                
                                        <Text id="rMaktx" text="" class="qrScanMaktx"/>                                                                                                                                                                        
                                    </VBox>                                                                                                                                                                                                                    
                                    <VBox class="qrScanHeroAmt" alignItems="End">                                                                                                                                                                              
                                        <Text id="rMenge" text="" class="qrScanAmt"/>                                                                                                                                                                          
                                        <Text id="rLgort" text="" class="qrScanLgort"/>                                                                                                                                                                        
                                        <Button text="창고 현황에서 보기" icon="sap-icon://inventory" type="Transparent" press="onViewMaterialStock" class="sapUiSmallMarginTop"/>                                                                                     
                                    </VBox>                                                                                                                                                                                                                    
                                </HBox>                                                                                                                                                                                                                        
                            </VBox>                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                            <!-- 본문: 정보+현재위치 | 이동이력 -->                                                                                                                                                                                                        
                            <HBox class="qrScanBody">                                                                                                                                                                                                          
                                <VBox class="qrScanColL">                                                                                                                                                                                                      
                                    <VBox class="qrScanCard">                                                                                                                                                                                                  
                                        <HBox class="qrScanSecHead" alignItems="Center">                                                                                                                                                                       
                                            <core:Icon src="sap-icon://hint" size="1rem" color="#0A6ED1"/>                                                                                                                                                     
                                            <Title text="기본 정보" level="H5" class="qrScanSecTitle"/>                                                                                                                                                            
                                        </HBox>                                                                                                                                                                                                                
                                        <VBox class="qrScanInfoGrid">                                                                                                                                                                                          
                                            <HBox class="qrScanField" alignItems="Center">                                                                                                                                                                     
                                                <Label text="QR번호" class="qrScanFieldLbl"/>                                                                                                                                                                    
                                                <Text id="rQrNo" text="" class="qrScanFieldVal"/>                                                                                                                                                              
                                            </HBox>                                                                                                                                                                                                            
                                            <HBox class="qrScanField" alignItems="Center">                                                                                                                                                                     
                                                <Label text="배치번호" class="qrScanFieldLbl"/>                                                                                                                                                                    
                                                <Text id="rCharg" text="" class="qrScanFieldVal"/>                                                                                                                                                             
                                            </HBox>                                                                                                                                                                                                            
                                            <HBox class="qrScanField" alignItems="Center">                                                                                                                                                                     
                                                <Label text="구매오더" class="qrScanFieldLbl"/>                                                                                                                                                                    
                                                <Text id="rEbeln" text="" class="qrScanFieldVal"/>                                                                                                                                                             
                                            </HBox>                                                                                                                                                                                                            
                                            <HBox class="qrScanField" alignItems="Center">                                                                                                                                                                     
                                                <Label text="입고문서" class="qrScanFieldLbl"/>                                                                                                                                                                    
                                                <Text id="rMblnr" text="" class="qrScanFieldVal"/>                                                                                                                                                             
                                            </HBox>                                                                                                                                                                                                            
                                            <HBox class="qrScanField" alignItems="Center">                                                                                                                                                                     
                                                <Label text="공급업체" class="qrScanFieldLbl"/>                                                                                                                                                                    
                                                <Text id="rVenName" text="" class="qrScanFieldVal"/>                                                                                                                                                           
                                            </HBox>                                                                                                                                                                                                            
                                            <HBox class="qrScanField" alignItems="Center">                                                                                                                                                                     
                                                <Label text="입고일" class="qrScanFieldLbl"/>                                                                                                                                                                     
                                                <Text id="rGrDate" text="" class="qrScanFieldVal"/>                                                                                                                                                            
                                            </HBox>                                                                                                                                                                                                            
                                        </VBox>                                                                                                                                                                                                                
                                    </VBox>                                                                                                                                                                                                                    
                                    <VBox class="qrScanCard sapUiSmallMarginTop">                                                                                                                                                                              
                                        <HBox class="qrScanSecHead" alignItems="Center">                                                                                                                                                                       
                                            <core:Icon src="sap-icon://map" size="1rem" color="#0A6ED1"/>                                                                                                                                                      
                                            <Title text="이 배치 현재 위치" level="H5" class="qrScanSecTitle"/>                                                                                                                                                       
                                        </HBox>                                                                                                                                                                                                                
                                        <Table id="rStockTable" noDataText="현재고 정보 없음" fixedLayout="false" class="qrStockTable qrScanTable">                                                                                                                   
                                            <columns>                                                                                                                                                                                                          
                                                <Column width="6.5rem"><Text text="저장위치"/></Column>                                                                                                                                                            
                                                <Column hAlign="Right"><Text text="총재고"/></Column>                                                                                                                                                             
                                                <Column hAlign="Right"><Text text="가용"/></Column>                                                                                                                                                              
                                                <Column hAlign="Right"><Text text="검사중"/></Column>                                                                                                                                                             
                                                <Column hAlign="Right"><Text text="보류"/></Column>                                                                                                                                                              
                                                <Column width="3rem" hAlign="Center"><Text text="단위"/></Column>                                                                                                                                                
                                            </columns>                                                                                                                                                                                                         
                                        </Table>                                                                                                                                                                                                               
                                    </VBox>                                                                                                                                                                                                                    
                                </VBox>                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
                                <VBox class="qrScanColR">                                                                                                                                                                                                      
                                    <VBox class="qrScanCard qrScanMoveCard">                                                                                                                                                                                   
                                        <HBox class="qrScanSecHead" alignItems="Center">                                                                                                                                                                       
                                            <core:Icon src="sap-icon://journey-arrive" size="1rem" color="#0A6ED1"/>                                                                                                                                           
                                            <Title text="이동 이력" level="H5" class="qrScanSecTitle"/>                                                                                                                                                            
                                        </HBox>                                                                                                                                                                                                                
                                        <Text id="rMoveSummary" text="" class="qrMoveSummary"/>                                                                                                                                                                
                                        <SegmentedButton id="segMoveFilter" selectionChange="onMoveFilter" selectedKey="ALL" width="100%" class="qrMoveFilter sapUiTinyMarginTop">                                                                             
                                            <items>                                                                                                                                                                                                            
                                                <SegmentedButtonItem key="ALL" text="전체"/>                                                                                                                                                                     
                                                <SegmentedButtonItem key="입고" text="입고"/>                                                                                                                                                                      
                                                <SegmentedButtonItem key="출고" text="출고"/>                                                                                                                                                                      
                                                <SegmentedButtonItem key="이동" text="이동"/>                                                                                                                                                                      
                                            </items>                                                                                                                                                                                                           
                                        </SegmentedButton>                                                                                                                                                                                                     
                                        <ScrollContainer height="15rem" vertical="true" horizontal="false" class="sapUiTinyMarginTop">                                                                                                                         
                                            <List id="rMoveHistList" noDataText="이동 이력 없음" class="qrMoveList"/>                                                                                                                                                
                                        </ScrollContainer>                                                                                                                                                                                                     
                                    </VBox>                                                                                                                                                                                                                    
                                </VBox>                                                                                                                                                                                                                        
                            </HBox>                                                                                                                                                                                                                            
                        </VBox>                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
                    </VBox>                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
                </HBox>                                                                                                                                                                                                                                        
            </VBox>                                                                                                                                                                                                                                            
        </content>                                                                                                                                                                                                                                             
    </Page>                                                                                                                                                                                                                                                    
</mvc:View>                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               