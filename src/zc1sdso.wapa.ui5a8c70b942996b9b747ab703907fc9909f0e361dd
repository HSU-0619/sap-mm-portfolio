sap.ui.define([], function () {                                                                                                                                                                                                                                
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    var FIELD_LABELS = {                                                                                                                                                                                                                                       
        KWMENG: "주문수량",                                                                                                                                                                                                                                        
        VDATU:  "납기일",   // 헤더 납기일 (실제 로깅 필드)                                                                                                                                                                                                                  
        NETWR:  "금액",                                                                                                                                                                                                                                          
        NETPR:  "단가",                                                                                                                                                                                                                                          
        EDATU:  "납기일",                                                                                                                                                                                                                                         
        WERKS:  "플랜트",                                                                                                                                                                                                                                         
        KUNNR:  "고객",                                                                                                                                                                                                                                          
        KWERT:  "금액",                                                                                                                                                                                                                                          
        VRKME:  "판매단위",                                                                                                                                                                                                                                        
        WAERK:  "통화"                                                                                                                                                                                                                                           
    };                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
    function toNumber(v) {                                                                                                                                                                                                                                     
        if (v === null || v === undefined) { return NaN; }                                                                                                                                                                                                     
        var t = String(v).trim().replace(/,/g, "");                                                                                                                                                                                                            
        if (t === "" || /^\d{8}$/.test(t)) { return NaN; } // 빈값/날짜는 증감 제외                                                                                                                                                                                     
        return /^-?\d+(\.\d+)?$/.test(t) ? parseFloat(t) : NaN;                                                                                                                                                                                                
    }                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
    return {                                                                                                                                                                                                                                                   
        // CDPOS 내부 값 → 표시용 (날짜 yyyymmdd→yyyy.mm.dd, 숫자 천단위, 그 외 원본)                                                                                                                                                                                           
        value: function (sVal) {                                                                                                                                                                                                                               
            if (sVal === null || sVal === undefined) { return ""; }                                                                                                                                                                                            
            var s = String(sVal).trim();                                                                                                                                                                                                                       
            if (s === "") { return "—"; }                                                                                                                                                                                                                      
            if (/^\d{8}$/.test(s)) {                                                                                                                                                                                                                           
                var y = s.substring(0, 4), m = s.substring(4, 6), d = s.substring(6, 8);                                                                                                                                                                       
                if (y >= "1900" && y <= "2999" && m >= "01" && m <= "12" && d >= "01" && d <= "31") {                                                                                                                                                          
                    return y + "." + m + "." + d;                                                                                                                                                                                                              
                }                                                                                                                                                                                                                                              
            }                                                                                                                                                                                                                                                  
            if (/^-?\d+(\.\d+)?$/.test(s)) {                                                                                                                                                                                                                   
                var bNeg = s.charAt(0) === "-";                                                                                                                                                                                                                
                var sAbs = bNeg ? s.substring(1) : s;                                                                                                                                                                                                          
                var aParts = sAbs.split(".");                                                                                                                                                                                                                  
                aParts[0] = aParts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");                                                                                                                                                                                   
                if (aParts[1]) {                                                                                                                                                                                                                               
                    aParts[1] = aParts[1].replace(/0+$/, "");                                                                                                                                                                                                  
                    if (aParts[1] === "") { aParts.pop(); }                                                                                                                                                                                                    
                }                                                                                                                                                                                                                                              
                return (bNeg ? "-" : "") + aParts.join(".");                                                                                                                                                                                                   
            }                                                                                                                                                                                                                                                  
            return s;                                                                                                                                                                                                                                          
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // 필드 한글명 (FNAME 우선 매핑, 없으면 CDS 라벨/원본)                                                                                                                                                                                                                 
        fieldLabel: function (sFname, sCdsLabel) {                                                                                                                                                                                                             
            return FIELD_LABELS[sFname] || sCdsLabel || sFname || "";                                                                                                                                                                                          
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // 판매오더 번호 표시용 (앞 0 제거)                                                                                                                                                                                                                                
        soDisplay: function (sSo) {                                                                                                                                                                                                                            
            if (!sSo) { return ""; }                                                                                                                                                                                                                           
            var n = String(sSo).replace(/^0+/, "");                                                                                                                                                                                                            
            return n === "" ? "0" : n;                                                                                                                                                                                                                         
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // 아이템 번호 표시용 (000000 헤더 → '오더 전체')                                                                                                                                                                                                                    
        itemDisplay: function (sItem) {                                                                                                                                                                                                                        
            if (!sItem) { return "오더 전체"; }                                                                                                                                                                                                                    
            var n = String(sItem).replace(/^0+/, "");                                                                                                                                                                                                          
            return n === "" ? "오더 전체" : "품목 " + n;                                                                                                                                                                                                             
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // 헤더/품목 구분 아이콘                                                                                                                                                                                                                                        
        levelIcon: function (sTab) {                                                                                                                                                                                                                           
            return sTab === "ZTC1SD0002" ? "sap-icon://product" : "sap-icon://document-text";                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // 증감 아이콘 (숫자일 때만)                                                                                                                                                                                                                                     
        trendIcon: function (sOld, sNew) {                                                                                                                                                                                                                     
            var a = toNumber(sOld), b = toNumber(sNew);                                                                                                                                                                                                        
            if (isNaN(a) || isNaN(b) || a === b) { return ""; }                                                                                                                                                                                                
            return b > a ? "sap-icon://trend-up" : "sap-icon://trend-down";                                                                                                                                                                                    
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // 증감 아이콘 색상 (증가=파랑, 감소=빨강)                                                                                                                                                                                                                            
        trendColor: function (sOld, sNew) {                                                                                                                                                                                                                    
            var a = toNumber(sOld), b = toNumber(sNew);                                                                                                                                                                                                        
            if (isNaN(a) || isNaN(b) || a === b) { return "Default"; }                                                                                                                                                                                         
            return b > a ? "#0a6ed1" : "#bb0000";                                                                                                                                                                                                              
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // 변경 후 값 색상 상태 (증가=파랑Information, 감소=빨강Error, 그 외=강조)                                                                                                                                                                                                 
        changeState: function (sOld, sNew) {                                                                                                                                                                                                                   
            var a = toNumber(sOld), b = toNumber(sNew);                                                                                                                                                                                                        
            if (isNaN(a) || isNaN(b) || a === b) { return "Information"; }                                                                                                                                                                                     
            return b > a ? "Information" : "Error";                                                                                                                                                                                                            
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // 문서유형(VBTYP) → 한글 (C=오더, J=납품, M=청구 ...)                                                                                                                                                                                                             
        docTypeText: function (sVbtyp) {                                                                                                                                                                                                                       
            switch (sVbtyp) {                                                                                                                                                                                                                                  
                case "C": return "판매오더";                                                                                                                                                                                                                       
                case "J": return "납품";                                                                                                                                                                                                                         
                case "M": return "청구";                                                                                                                                                                                                                         
                case "O": return "청구취소";                                                                                                                                                                                                                       
                case "H": return "반품";                                                                                                                                                                                                                         
                default:  return "문서";                                                                                                                                                                                                                         
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // ATP 계산 — 날짜별 누적 가용수량으로 최단 출고가능일 도출                                                                                                                                                                                                                  
        //  required     : 필요수량 (변경 후 주문수량)                                                                                                                                                                                                                    
        //  oRequested   : 요청 납기일 (Date)                                                                                                                                                                                                                       
        //  avail        : 현재 가용재고                                                                                                                                                                                                                             
        //  aReceipts    : [{ date: Date, qty: number }]  생산 입고예정                                                                                                                                                                                              
        computeAtp: function (required, oRequested, avail, aReceipts) {                                                                                                                                                                                        
            var aSorted = (aReceipts || [])                                                                                                                                                                                                                    
                .map(function (r) { return { date: r.date, qty: Number(r.qty) || 0 }; })                                                                                                                                                                       
                .filter(function (r) { return r.qty > 0 && r.date; })                                                                                                                                                                                          
                .sort(function (a, b) { return a.date - b.date; });                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
            var nIncoming = aSorted.reduce(function (s, r) { return s + r.qty; }, 0);                                                                                                                                                                          
            var cum = Number(avail) || 0;                                                                                                                                                                                                                      
            var oShip = null;                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            if (cum >= required) {                                                                                                                                                                                                                             
                oShip = new Date(); // 즉시 출고 가능                                                                                                                                                                                                                
            } else {                                                                                                                                                                                                                                           
                for (var i = 0; i < aSorted.length; i++) {                                                                                                                                                                                                     
                    cum += aSorted[i].qty;                                                                                                                                                                                                                     
                    if (cum >= required) { oShip = aSorted[i].date; break; }                                                                                                                                                                                   
                }                                                                                                                                                                                                                                              
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            var bCovered = oShip !== null;                                                                                                                                                                                                                     
            var nShortage = bCovered ? 0 : (required - cum);                                                                                                                                                                                                   
            var nDelay = null;                                                                                                                                                                                                                                 
            if (bCovered && oRequested instanceof Date && oShip instanceof Date) {                                                                                                                                                                             
                // 날짜만 비교 (시간 제거)                                                                                                                                                                                                                              
                var d1 = Date.UTC(oShip.getFullYear(), oShip.getMonth(), oShip.getDate());                                                                                                                                                                     
                var d2 = Date.UTC(oRequested.getFullYear(), oRequested.getMonth(), oRequested.getDate());                                                                                                                                                      
                nDelay = Math.round((d1 - d2) / 86400000);                                                                                                                                                                                                     
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            return {                                                                                                                                                                                                                                           
                available: Number(avail) || 0,                                                                                                                                                                                                                 
                incoming: nIncoming,                                                                                                                                                                                                                           
                shipDate: oShip,                                                                                                                                                                                                                               
                covered: bCovered,                                                                                                                                                                                                                             
                immediate: (Number(avail) || 0) >= required,  // 현재고만으로 즉시 충당                                                                                                                                                                                  
                shortage: nShortage,                                                                                                                                                                                                                           
                delayDays: nDelay                                                                                                                                                                                                                              
            };                                                                                                                                                                                                                                                 
        }                                                                                                                                                                                                                                                      
    };                                                                                                                                                                                                                                                         
});                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               