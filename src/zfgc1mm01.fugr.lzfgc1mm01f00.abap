FORM DB_UPD_ZMVA1MM0011 .
*.process data base updates/inserts/deletes.........................*
LOOP AT TOTAL.
  CHECK <ACTION> NE ORIGINAL.
MOVE <VIM_TOTAL_STRUC> TO ZMVA1MM0011.
  IF <ACTION> = UPDATE_GELOESCHT.
    <ACTION> = GELOESCHT.
  ENDIF.
  CASE <ACTION>.
   WHEN NEUER_GELOESCHT.
IF STATUS_ZMVA1MM0011-ST_DELETE EQ GELOESCHT.
     READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
     IF SY-SUBRC EQ 0.
       DELETE EXTRACT INDEX SY-TABIX.
     ENDIF.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN GELOESCHT.
  SELECT SINGLE FOR UPDATE * FROM ZTC1MM0005 WHERE
  MBLNR = ZMVA1MM0011-MBLNR AND
  MJAHR = ZMVA1MM0011-MJAHR AND
  ZEILE = ZMVA1MM0011-ZEILE .
    IF SY-SUBRC = 0.
    DELETE ZTC1MM0005 .
    ENDIF.
    IF STATUS-DELETE EQ GELOESCHT.
      READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY> BINARY SEARCH.
      DELETE EXTRACT INDEX SY-TABIX.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN OTHERS.
  SELECT SINGLE FOR UPDATE * FROM ZTC1MM0005 WHERE
  MBLNR = ZMVA1MM0011-MBLNR AND
  MJAHR = ZMVA1MM0011-MJAHR AND
  ZEILE = ZMVA1MM0011-ZEILE .
    IF SY-SUBRC <> 0.   "insert preprocessing: init WA
